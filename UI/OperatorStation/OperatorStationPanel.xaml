<UserControl x:Class="CNCSS.UI.OperatorStation.OperatorStationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="400"
             MinHeight="280">
    <UserControl.Resources>
        <!-- Общие градиенты «фаска»: свет TL / тёмный BR как на промышленных пультах -->
        <LinearGradientBrush x:Key="OpcKeyFaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFEEF1F6" Offset="0"/>
            <GradientStop Color="#FFBFC8D4" Offset="0.48"/>
            <GradientStop Color="#FF9EA8B6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OpcKeyFaceBrushHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF6FAFF" Offset="0"/>
            <GradientStop Color="#FFDCE5F2" Offset="0.52"/>
            <GradientStop Color="#FFB5C5D9" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OpcKeyFaceBrushSelected" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE4F6FF" Offset="0"/>
            <GradientStop Color="#FFA9CDE8" Offset="0.5"/>
            <GradientStop Color="#FF7BADCC" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OpcKeyBezelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFDDE3EB" Offset="0"/>
            <GradientStop Color="#FF4D535C" Offset="1"/>
        </LinearGradientBrush>
        <!-- LED выкл.: тёмный «стекло» -->
        <SolidColorBrush x:Key="OpcLedLensOffBrush" Color="#FF2A3038"/>
        <RadialGradientBrush x:Key="OpcLedLensOnBrush" GradientOrigin="0.35,0.35" Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
            <GradientStop Color="#FFFFFAE0" Offset="0"/>
            <GradientStop Color="#FFD4C400" Offset="0.72"/>
            <GradientStop Color="#FF8A7900" Offset="1"/>
        </RadialGradientBrush>
        <DropShadowEffect x:Key="OpcKeyDropShadow"
                          BlurRadius="6"
                          Direction="298"
                          ShadowDepth="3.2"
                          Opacity="0.58"
                          Color="#FF050508"/>

        <!-- Ключ 52×52: тень на панели + объём по референсу -->
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF0A0B0E"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto" MinHeight="62"/>
                            </Grid.RowDefinitions>
                            <!-- LED над клавишей, «вмонтированный» -->
                            <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Width="14" Height="12" ClipToBounds="False">
                                <Grid>
                                    <Ellipse Fill="#FF1E2228" Stroke="#FF090A0D" StrokeThickness="1.2" Margin="2,5,2,1"/>
                                    <Ellipse x:Name="LedLens" Width="8.5" Height="8.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0"
                                             Stroke="#FF5C6570" StrokeThickness="1" Fill="{StaticResource OpcLedLensOffBrush}"/>
                                    <Ellipse Width="3" Height="2" Margin="-2,-6,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="#55FFFFFF"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Margin="1,3,3,2" HorizontalAlignment="Center" VerticalAlignment="Top" Width="54" Height="54"
                                    Effect="{StaticResource OpcKeyDropShadow}" Background="Transparent">
                                <Border x:Name="FaceOuter" CornerRadius="3.5" BorderThickness="1" Padding="1.5">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFF5F8FC" Offset="0"/>
                                            <GradientStop Color="#FFB3BAC4" Offset="0.42"/>
                                            <GradientStop Color="#FF3F454E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border x:Name="Face" CornerRadius="2.8" Margin="0" Background="{StaticResource OpcKeyFaceBrush}">
                                        <Grid>
                                            <!-- лёгкий блик сверху слева -->
                                            <Border Height="38" VerticalAlignment="Top" Margin="6,7,22,0" CornerRadius="2" Opacity="0.42"
                                                    HorizontalAlignment="Left" Width="20"
                                                    Background="White"/>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LedLens" Property="Fill" Value="{StaticResource OpcLedLensOnBrush}"/>
                                <Setter TargetName="LedLens" Property="Stroke" Value="#FFD4BF00"/>
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource OpcKeyFaceBrushSelected}"/>
                                <Setter TargetName="FaceOuter" Property="BorderBrush" Value="{StaticResource OpcKeyBezelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="LedLens" Property="Fill" Value="{StaticResource OpcLedLensOffBrush}"/>
                                <Setter TargetName="LedLens" Property="Stroke" Value="#FF5C6570"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource OpcKeyFaceBrushHover}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFB8E9FF" Offset="0"/>
                                            <GradientStop Color="#FF6BAFEC" Offset="0.52"/>
                                            <GradientStop Color="#FF3D7FA8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.52"/>
                                <Setter TargetName="LedLens" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

