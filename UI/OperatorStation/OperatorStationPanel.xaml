        <!-- Пустые ячейки: такой же профиль объёма + тусклый LED -->
        <Style x:Key="OpcPh" TargetType="Button">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid MinHeight="78" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto" MinHeight="62"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Width="14" Height="12">
                                <Grid>
                                    <Ellipse Fill="#FF1E2228" Stroke="#FF090A0D" StrokeThickness="1.2" Margin="2,5,2,1"/>
                                    <Ellipse Width="8.5" Height="8.5" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Stroke="#FF5C6570" StrokeThickness="1" Fill="{StaticResource OpcLedLensOffBrush}"/>
                                    <Ellipse Width="3" Height="2" Margin="-2,-6,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="#40FFFFFF"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Margin="1,3,3,2" HorizontalAlignment="Center" VerticalAlignment="Top" Width="54" Height="54"
                                    Effect="{StaticResource OpcKeyDropShadow}">
                                <Border CornerRadius="3.5" BorderThickness="1" Padding="1.5">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFD4DADF" Offset="0"/>
                                            <GradientStop Color="#FFB0B9C7" Offset="0.42"/>
                                            <GradientStop Color="#FF585F6A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border CornerRadius="2.8" Margin="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FFA8ADB6" Offset="0"/>
                                                <GradientStop Color="#FF7D8490" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FF333333"
            BorderBrush="#FF222222"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,10,10,12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="152" MinWidth="120"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: E-STOP + ручки F/S -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,6">
                    <Ellipse Width="108" Height="108" Fill="#FFF1C40F" Stroke="#FFC49A00" StrokeThickness="2" VerticalAlignment="Bottom"/>
                    <Button x:Name="BtnEStop" Width="88" Height="88" Click="EStop_Click" Cursor="Hand"
                            ToolTip="Аварийный стоп / сброс"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-6,0,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse Fill="#FFC41E1E" Stroke="#FF8B1010" StrokeThickness="2">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.45" Color="#400000"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse Width="22" Height="22" Fill="#FF6D0E0E" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="F %" Foreground="#FFB8BCC6" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <Grid Width="84" Height="84" HorizontalAlignment="Center">
                            <Ellipse Fill="White" Stroke="#FF2A2A2A" StrokeThickness="2"/>
                            <Canvas Width="84" Height="84" ClipToBounds="True">
                                <Line x:Name="WorkOvNeedle" X1="42" Y1="42" X2="42" Y2="18" Stroke="Black" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Line.RenderTransform>
                                        <RotateTransform x:Name="WorkOvNeedleRotate" Angle="-135"/>
                                    </Line.RenderTransform>
                                </Line>
                            </Canvas>
                            <Slider x:Name="WorkOvSlider" Minimum="0" Maximum="120" Value="100" TickFrequency="10"
                                    IsSnapToTickEnabled="True" Opacity="0" Width="84" Height="84"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="FeedOvText" Text="100%" Foreground="#FFD0E8F0" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="S %" Foreground="#FFB8BCC6" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <Grid Width="84" Height="84" HorizontalAlignment="Center">
                            <Ellipse Fill="White" Stroke="#FF2A2A2A" StrokeThickness="2"/>
                            <Canvas Width="84" Height="84" ClipToBounds="True">
                                <Line x:Name="SpindleOvNeedle" X1="42" Y1="42" X2="42" Y2="18" Stroke="Black" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Line.RenderTransform>
                                        <RotateTransform x:Name="SpindleOvNeedleRotate" Angle="-67.5"/>
                                    </Line.RenderTransform>
                                </Line>
                            </Canvas>
                            <Slider x:Name="SpindleOvSlider" Minimum="50" Maximum="120" Value="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True" Opacity="0" Width="84" Height="84"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="SpindleOvText" Text="100%" Foreground="#FFD0E8F0" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Клавиатура: три блока по 4 — 4 — 3 кнопки, разделители между блоками -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="1" Grid.RowSpan="7" Width="1" Margin="11,14" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#FF4A4A4A"/>
                <Border Grid.Column="3" Grid.RowSpan="7" Width="1" Margin="11,14" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#FF4A4A4A"/>

                <!-- Ряд 0 -->
                <UniformGrid Grid.Row="0" Grid.Column="0" Columns="4">
                    <RadioButton x:Name="ModeAuto" GroupName="OpStaMode" Content="AUTO" Tag="AUTO" Checked="ModeRadio_Checked" IsChecked="True"/>
                    <RadioButton x:Name="ModeEdit" GroupName="OpStaMode" Content="EDIT" Tag="EDIT" Checked="ModeRadio_Checked"/>
                    <RadioButton x:Name="ModeMdi" GroupName="OpStaMode" Content="MDI" Tag="MDI" Checked="ModeRadio_Checked"/>
                    <Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="0" Grid.Column="2" Columns="4">
                    <RadioButton x:Name="ModeRef" GroupName="OpStaMode" Content="REF" Tag="REF" Checked="ModeRadio_Checked"/>
                    <RadioButton x:Name="ModeJog" GroupName="OpStaMode" Content="JOG" Tag="JOG" Checked="ModeRadio_Checked"/>
                    <RadioButton x:Name="ModeInc" GroupName="OpStaMode" Content="INC" Tag="INC" Checked="ModeRadio_Checked"/>
                    <RadioButton x:Name="ModeHnd" GroupName="OpStaMode" Content="HND" Tag="HND" Checked="ModeRadio_Checked"/>
                </UniformGrid>
                <UniformGrid Grid.Row="0" Grid.Column="4" Columns="3">
                    <ToggleButton x:Name="BtnCool" Style="{StaticResource OpcSquareToggle}" Content="COOL" ToolTip="СОЖ (индикация)"/>
                    <Button Style="{StaticResource OpcPh}"/>
                    <Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>

                <!-- Ряд 1 -->
                <UniformGrid Grid.Row="1" Grid.Column="0" Columns="4">
                    <ToggleButton x:Name="BtnSb" Style="{StaticResource OpcSquareToggle}" Content="SB" ToolTip="Покадровое выполнение"
                                  Checked="MachiningToggle_Changed" Unchecked="MachiningToggle_Changed"/>
                    <ToggleButton x:Name="BtnM1" Style="{StaticResource OpcSquareToggle}" Content="M1" ToolTip="Останов по M1"
                                  Checked="MachiningToggle_Changed" Unchecked="MachiningToggle_Changed"/>
                    <Button Style="{StaticResource OpcPh}"/>
                    <Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="1" Grid.Column="2" Columns="4">
                    <RadioButton x:Name="Inc1" GroupName="OpInc" Content="1" Tag="µ1" FontSize="10" Checked="IncRadio_Checked"/>
                    <RadioButton x:Name="Inc10" GroupName="OpInc" Content="10" Tag="µ10" Checked="IncRadio_Checked"/>
                    <RadioButton x:Name="Inc100" GroupName="OpInc" Content="100" Tag="µ100" FontSize="10" Checked="IncRadio_Checked"/>
                    <RadioButton x:Name="Inc1000" GroupName="OpInc" Content="1000" Tag="µ1000" FontSize="9" Checked="IncRadio_Checked"/>
                </UniformGrid>
                <UniformGrid Grid.Row="1" Grid.Column="4" Columns="3">
                    <Button Style="{StaticResource OpcPh}"/>
                    <Button Style="{StaticResource OpcPh}"/>
                    <Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>

                <!-- Ряд 2 — пустые прямоугольники во всех зонах -->
                <UniformGrid Grid.Row="2" Grid.Column="0" Columns="4">
                    <Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="2" Grid.Column="2" Columns="4">
                    <Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="2" Grid.Column="4" Columns="3">
                    <Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>

                <!-- Ряд 3 -->
                <UniformGrid Grid.Row="3" Grid.Column="0" Columns="4">
                    <Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="3" Grid.Column="2" Columns="4">
                    <Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="3" Grid.Column="4" Columns="3">
                    <RadioButton x:Name="AxisRadioX" GroupName="OpAxis" Content="X" Tag="X" Checked="AxisRadio_Checked" IsChecked="True"/>
                    <RadioButton x:Name="AxisRadioY" GroupName="OpAxis" Content="Y" Tag="Y" Checked="AxisRadio_Checked"/>
                    <RadioButton x:Name="AxisRadioZ" GroupName="OpAxis" Content="Z" Tag="Z" Checked="AxisRadio_Checked"/>
                </UniformGrid>

                <!-- Ряд 4 -->
                <UniformGrid Grid.Row="4" Grid.Column="0" Columns="4">
                    <Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="4" Grid.Column="2" Columns="4">
                    <Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="4" Grid.Column="4" Columns="3">
                    <Button x:Name="BtnJogPlus" Style="{StaticResource OpcSquareAction}" Content="+" FontSize="22" Click="JogPlus_Click"/>
                    <ToggleButton x:Name="BtnG0Rapid" Style="{StaticResource OpcSquareToggle}" Content="G0" ToolTip="Быстрый ход при джоге"
                                  Checked="G0Rapid_Changed" Unchecked="G0Rapid_Changed"/>
                    <Button x:Name="BtnJogMinus" Style="{StaticResource OpcSquareAction}" Content="−" FontSize="22" Click="JogMinus_Click"/>
                </UniformGrid>

                <!-- Ряд 5 -->
                <UniformGrid Grid.Row="5" Grid.Column="0" Columns="4">
                    <Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="5" Grid.Column="2" Columns="4">
                    <Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="5" Grid.Column="4" Columns="3">
                    <Button x:Name="BtnM3" Style="{StaticResource OpcSquareAction}" Content="M3" FontSize="11" ToolTip="M3 CW" Click="SpinCw_Click"/>
                    <Button x:Name="BtnM5" Style="{StaticResource OpcSquareAction}" Content="M5" FontSize="11" ToolTip="M5 Стоп" Click="SpinStop_Click"/>
                    <Button x:Name="BtnM4" Style="{StaticResource OpcSquareAction}" Content="M4" FontSize="11" ToolTip="M4 CCW" Click="SpinCcw_Click"/>
                </UniformGrid>

                <!-- Ряд 6 -->
                <UniformGrid Grid.Row="6" Grid.Column="0" Columns="4">
                    <Button x:Name="BtnCycleStart" Style="{StaticResource OpcCycleSqGreen}" Content="▶" ToolTip="Cycle Start" Click="CycleStart_Click"/>
                    <Button x:Name="BtnCycleStop" Style="{StaticResource OpcCycleSqRed}" Content="■" ToolTip="Cycle Stop" Click="CycleStop_Click"/>
                    <Button x:Name="BtnFeedHold" Style="{StaticResource OpcCycleSqMuted}" Content="┃" ToolTip="Feed Hold" Click="FeedHold_Click"/>
                    <Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="6" Grid.Column="2" Columns="4">
                    <Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
                <UniformGrid Grid.Row="6" Grid.Column="4" Columns="3">
                    <Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/><Button Style="{StaticResource OpcPh}"/>
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
