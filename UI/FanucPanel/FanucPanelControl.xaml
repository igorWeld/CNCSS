                <Button Grid.Column="0" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Content="&#9664;" Click="SoftkeyPrev_Click" Margin="2,2"/>
                <Button Grid.Column="1" x:Name="SoftKeyButton1" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="2" x:Name="SoftKeyButton2" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="3" x:Name="SoftKeyButton3" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="4" x:Name="SoftKeyButton4" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="5" x:Name="SoftKeyButton5" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="6" x:Name="SoftKeyButton6" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="7" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Content="&#9654;" Click="SoftkeyNext_Click" Margin="2,2"/>
            </Grid>

            <DockPanel x:Name="MdiInputRowPanel" Grid.Row="0" Grid.Column="0" Visibility="Collapsed"/>

            <StackPanel Visibility="Collapsed">
                <ComboBox x:Name="ModeComboBox" SelectionChanged="ModeComboBox_SelectionChanged"><ComboBoxItem Content="MEM" IsSelected="True"/></ComboBox>
                <TextBlock x:Name="JogLabelText"/>
                <ComboBox x:Name="JogStepComboBox" SelectionChanged="JogStepComboBox_SelectionChanged"><ComboBoxItem Content="1.0" IsSelected="True"/></ComboBox>
                <CheckBox x:Name="SingleBlockCheckBox" Checked="SingleBlockCheckBox_Changed" Unchecked="SingleBlockCheckBox_Changed"/>
                <CheckBox x:Name="OptionalStopCheckBox" Checked="OptionalStopCheckBox_Changed" Unchecked="OptionalStopCheckBox_Changed"/>
                <CheckBox x:Name="DryRunCheckBox" Checked="DryRunCheckBox_Changed" Unchecked="DryRunCheckBox_Changed"/>
                <ComboBox x:Name="OffsetSystemComboBox" SelectionChanged="OffsetSystemComboBox_SelectionChanged"><ComboBoxItem Content="G54" IsSelected="True"/></ComboBox>
                <TextBox x:Name="OffsetXTextBox" TextChanged="OffsetEditorField_TextChanged"/>
                <TextBox x:Name="OffsetYTextBox" TextChanged="OffsetEditorField_TextChanged"/>
                <TextBox x:Name="OffsetZTextBox" TextChanged="OffsetEditorField_TextChanged"/>
                <Button x:Name="OffsetApplyButton" Click="OffsetApply_Click"/>
                <Button Click="OffsetReadActive_Click"/>
                <Button Click="CycleStart_Click"/>
                <Button Click="FeedHold_Click"/>
                <Button Click="JogXPlus_Click"/>
                <Button Click="JogXMinus_Click"/>
                <Button Click="JogYPlus_Click"/>
                <Button Click="JogYMinus_Click"/>
                <Button Click="JogZPlus_Click"/>
                <Button Click="JogZMinus_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
