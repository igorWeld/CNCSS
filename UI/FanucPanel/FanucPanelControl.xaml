<UserControl x:Class="CNCSS.UI.FanucPanel.FanucPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top"
             MinWidth="600"
             MinHeight="368">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="KeyWhiteBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFCFCFC" Offset="0"/>
            <GradientStop Color="#FFE8E8E8" Offset="1"/>
        </LinearGradientBrush>
        <!-- 0i-MF PROG: единый серый экран (#D1D7DC); бирюзовые полосы #5BB2C3 (верхняя + ввод + вторая — одна палитра) -->
        <SolidColorBrush x:Key="FanucProgDisplayBrush" Color="#FFD1D7DC"/>
        <SolidColorBrush x:Key="FanucProgCyanBrush" Color="#FF5BB2C3"/>
        <SolidColorBrush x:Key="FanucProgCyanBorderBrush" Color="#FF4A9EAF"/>
        <LinearGradientBrush x:Key="KeyBeigeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF0E4C7" Offset="0"/>
            <GradientStop Color="#FFDCCCA1" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="FanucKeyBaseStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FF1A1A1A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border Margin="1" CornerRadius="4" BorderBrush="#66FFFFFF" BorderThickness="1,1,1,0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#FF9A9A9A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MdiWhiteKeyStyle" TargetType="Button" BasedOn="{StaticResource FanucKeyBaseStyle}">
            <Setter Property="Margin" Value="1.6"/>
            <Setter Property="Background" Value="{StaticResource KeyWhiteBrush}"/>
            <Setter Property="BorderBrush" Value="#FFB9B9B9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="MdiBeigeKeyStyle" TargetType="Button" BasedOn="{StaticResource MdiWhiteKeyStyle}">
            <Setter Property="Background" Value="{StaticResource KeyBeigeBrush}"/>
            <Setter Property="BorderBrush" Value="#FF9E947A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="MdiArrowKeyStyle" TargetType="Button" BasedOn="{StaticResource MdiWhiteKeyStyle}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="FanucMdiInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#FF0F2A38"/>
            <Setter Property="CaretBrush" Value="#FF0F2A38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="SoftKeyPhysicalButtonStyle" TargetType="Button" BasedOn="{StaticResource FanucKeyBaseStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFF2F2F2" Offset="0"/>
                        <GradientStop Color="#FFD2D2D2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#FFAEAEAE"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="HelpResetKeyStyle" TargetType="Button" BasedOn="{StaticResource FanucKeyBaseStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="1.6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="ScreenInfoTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="#FF0086A8"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- S и L%: единый стиль как в блоке метрик POS (RPM слева, нагрузка справа) -->
        <Style x:Key="FanucMetricSpindleRpmBaseStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="#FF202020"/>
            <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.45" ScaleY="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FanucMetricSpindleRpmDockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FanucMetricSpindleRpmBaseStyle}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <Style x:Key="FanucMetricSpindleLoadDockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FanucMetricSpindleRpmBaseStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="ScreenSoftLabelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFC7CBCE"/>
            <Setter Property="BorderBrush" Value="#FF53585C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ScreenSoftLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource FanucKeyBaseStyle}"/>
    </UserControl.Resources>

    <Border Background="#FF878787" BorderBrush="#FF656565" BorderThickness="2" Padding="10,8,10,7"
            HorizontalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch">
            <!-- Пропорции ~456 : 296, растягиваются при увеличении окна -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228*" MinWidth="340"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="148*" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Background="#FF929292" BorderBrush="#FF5C5C5C" BorderThickness="2" Padding="7,7,7,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="254"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#FFE8D400" SnapsToDevicePixels="True">
                        <TextBlock Text="FANUC"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#FFCC0000"
                                   TextOptions.TextFormattingMode="Display"/>
                    </Grid>

                    <!-- Horizontal 21: рамка 2 + паддинг 9 + край строки программы 10 — одна база для PROGRAM/O N и строк G-кода -->
                    <Border Grid.Row="1"
                            Margin="0,1,0,0"
                            Background="{StaticResource FanucProgCyanBrush}"
                            BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                            BorderThickness="1,1,1,1"
                            Padding="21,6,21,6">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="ScreenRunStateText"
                                       DockPanel.Dock="Right"
                                       Text="00001 N00000"
                                       TextAlignment="Right"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="31"
                                       Foreground="#FF0F2A38"
                                       Margin="0"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0,0.5"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.LayoutTransform>
                                    <ScaleTransform ScaleX="0.38" ScaleY="0.38"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                            <TextBlock x:Name="ScreenModeText"
                                       Text="ACTUAL POSITION(ABSOLUTE)"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="31"
                                       Foreground="#FF0F2A38"
                                       Margin="0"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0,0.5"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.LayoutTransform>
                                    <ScaleTransform ScaleX="0.38" ScaleY="0.38"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource FanucProgDisplayBrush}"
                            BorderBrush="#FF3C4950"
                            BorderThickness="2"
                            Padding="9,3,9,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="174"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="PosCoordinateBorder"
                                    Grid.Row="0"
                                    BorderBrush="#FF000000"
                                    BorderThickness="1"
                                    Margin="0,4,0,2"
                                    Padding="6.3,4.2,6.3,2.1">
                                <StackPanel x:Name="PosPagePanel">
                                    <TextBlock x:Name="ScreenPositionText" Text="X      -399.039&#10;Y      -199.361&#10;Z       -52.194" FontFamily="Consolas" FontSize="48" Foreground="#FF101010" LineHeight="53"/>
                                </StackPanel>
                            </Border>

                            <!-- PROGRAM: бирюза как у верхней полосы; поле программы на том же сером что весь экран (#D1D7DC) -->
                            <Grid x:Name="ProgPageRoot"
                                  Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Visibility="Collapsed"
                                  Background="{StaticResource FanucProgDisplayBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Вторая полоса того же бирюза, но ниже по высоте: O справа/слева как на 0i-MF -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource FanucProgCyanBrush}"
                                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                                        BorderThickness="1,0,1,1"
                                        Padding="21,2,21,4"
                                        Margin="0">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock x:Name="ScreenProgFgTopStripeText"
                                                   DockPanel.Dock="Right"
                                                   Text="(FG:EDIT)"
                                                   FontFamily="Consolas"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FFF0F8FA"
                                                   TextOptions.TextFormattingMode="Display"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ScreenProgStripeOLeft"
                                                   DockPanel.Dock="Left"
                                                   Text="O0001"
                                                   FontFamily="Consolas"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FF0F2A38"
                                                   Margin="0,0,12,0"
                                                   Visibility="Collapsed"
                                                   TextOptions.TextFormattingMode="Display"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1"
                                      Margin="0,0,0,2"
                                      Background="Transparent"
                                      SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="ProgMainScroll"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Background="Transparent"
                                                  TextOptions.TextFormattingMode="Display">
                                        <!-- 2.bt + Padding 9 + 10 — как у строки PROGRAM -->
                                        <StackPanel Margin="10,8,14,11">
                                            <StackPanel Name="ProgGCodeLineHost" Margin="0,0,0,0" Visibility="Collapsed"/>
                                            <TextBlock x:Name="ScreenProgNoProgramText"
                                                       Text="NO PROGRAM"
                                                       FontFamily="Consolas"
                                                       FontSize="13.5"
                                                       FontWeight="Normal"
                                                       Foreground="#FF101010"
                                                       TextOptions.TextFormattingMode="Display"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border x:Name="ProgDirectoryScroll"
                                            Visibility="Collapsed"
                                            ClipToBounds="True"
                                            MaxHeight="344"
                                            HorizontalAlignment="Stretch">
                                        <!-- Без прокрутки: перелистывание списка программ — кнопки PAGE↑/PAGE↓ -->
                                        <StackPanel x:Name="ProgDirectoryRowsPanel"
                                                    Margin="14,12,14,14"
                                                    HorizontalAlignment="Stretch"/>
                                    </Border>
                                </Grid>

                                <!-- Строка ввода MDI (> _): низкая, чуть выше высоты глифа, как на референсе -->
                                <Border Grid.Row="2"
                                        HorizontalAlignment="Stretch"
                                        Background="{StaticResource FanucProgCyanBrush}"
                                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                                        BorderThickness="1"
                                        Padding="21,3,21,5"
                                        Margin="0,4,0,10"
                                        VerticalAlignment="Bottom"
                                        SnapsToDevicePixels="True">
                                    <DockPanel VerticalAlignment="Center" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="&gt;"
                                                   FontFamily="Consolas"
                                                   FontWeight="Bold"
                                                   FontSize="13.5"
                                                   LineHeight="17"
                                                   Margin="0,0,8,0"
                                                   Foreground="#FF0F2A38"
                                                   VerticalAlignment="Center"
                                                   TextOptions.TextFormattingMode="Display"/>
                                        <TextBox x:Name="MdiInputTextBox"
                                                 Style="{StaticResource FanucMdiInputTextBoxStyle}"
                                                 VerticalAlignment="Center"
                                                 MinHeight="19"
                                                 PreviewKeyDown="MdiInputTextBox_PreviewKeyDown"
                                                 TextChanged="MdiInputTextBox_TextChanged"
                                                 GotKeyboardFocus="MdiInputTextBox_FocusChangedHandler"
                                                 LostKeyboardFocus="MdiInputTextBox_FocusChangedHandler"/>
                                    </DockPanel>
                                </Border>

                                <!-- PROG: S и обороты одной строкой как раньше; блок вправо — примерно над часами -->
                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,10,18,14"
                                            Background="Transparent">
                                    <TextBlock x:Name="ProgSpindleRpmMirrorText"
                                               Style="{StaticResource FanucMetricSpindleRpmDockStyle}"
                                               Text="S  0"
                                               VerticalAlignment="Center"
                                               Margin="0,0,22,0"/>
                                    <TextBlock x:Name="ProgSpindleLoadMirrorText"
                                               Style="{StaticResource FanucMetricSpindleLoadDockStyle}"
                                               Text="L100%"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- совместимость с UiRenderService -->
                                <StackPanel Width="0" Height="0" Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock x:Name="ScreenToolText" Text="TOOL: -"/>
                                    <TextBlock x:Name="ScreenCoordText" Text="WCS: G54"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="OffsetPagePanel" Grid.Row="0" Visibility="Collapsed">
                                <TextBlock x:Name="ScreenOffsetCoordText" Text="NO.   GEOM(H) WEAR(H) GEOM(D) WEAR(D)" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock x:Name="ScreenOffsetXText" Text="001    0.000    0.000    0.000    0.000" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock x:Name="ScreenOffsetYText" Text="002    0.000    0.000    0.000    0.000" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock x:Name="ScreenOffsetZText" Text="003    0.000    0.000    0.000    0.000" FontFamily="Consolas" FontSize="14"/>
                            </StackPanel>

                            <StackPanel x:Name="AlarmPagePanel" Grid.Row="0" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="162"
                                              Padding="0,2,8,6"
                                              Background="Transparent">
                                    <TextBlock x:Name="ScreenMessageBodyText"
                                               FontFamily="Consolas"
                                               FontSize="13.5"
                                               Foreground="#FF101010"
                                               TextWrapping="Wrap"
                                               TextOptions.TextFormattingMode="Display"
                                               LineHeight="19"
                                               Text=""/>
                                </ScrollViewer>
                                <TextBlock x:Name="ScreenCoolantText" Text="COOLANT: OFF" Visibility="Collapsed"/>
                                <TextBlock x:Name="ScreenRefText" Text="REF: ABS (G90)" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel x:Name="DiagnPagePanel" Grid.Row="0" Visibility="Collapsed">
                                <TextBlock x:Name="ScreenDiagnModeText" Text="MODE: MEM" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenDiagnMdiModeText" Text="MDI: G90" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenDiagnCycleText" Text="CYCLE: FEED HOLD" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenDiagnLastMdiText" Text="LAST MDI: -" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenDiagnMdiStatusText" Text="MDI STATUS: -" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenDiagnInterlockCodeText" Text="INTERLOCK CODE: OK" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenDiagnInterlockDetailText" Text="INTERLOCK DETAIL: -" FontFamily="Consolas" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ScreenDiagnSingleBlockText" Text="SINGLE BLOCK: OFF" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenDiagnOptionalStopText" Text="OPTIONAL STOP: OFF" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenDiagnDryRunText" Text="DRY RUN: OFF" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenDiagnLimitsText" Text="LIMITS X[-500;500] Y[-500;500] Z[-300;300]" FontFamily="Consolas"/>
                            </StackPanel>

                            <StackPanel x:Name="SettingPagePanel" Grid.Row="0" Visibility="Collapsed">
                                <TextBlock x:Name="ScreenSettingWorkOverrideText" Text="WORK OVERRIDE: 100%" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenSettingRapidOverrideText" Text="RAPID OVERRIDE: 100%" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenSettingSingleBlockText" Text="SINGLE BLOCK: OFF" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenSettingOptionalStopText" Text="OPTIONAL STOP: OFF" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenSettingDryRunText" Text="DRY RUN: OFF" FontFamily="Consolas"/>
                            </StackPanel>

                            <StackPanel x:Name="SystemPagePanel" Grid.Row="0" Visibility="Collapsed">
                                <TextBlock x:Name="ScreenSystemUnitsText" Text="UNITS: MM (G21)" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenSystemCoordModeText" Text="COORD MODE: ABS (G90)" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenSystemPlaneText" Text="PLANE: G17 (XY)" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenSystemMotionText" Text="MOTION: G0" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenSystemWcsText" Text="ACTIVE WCS: G54" FontFamily="Consolas"/>
                                <TextBlock x:Name="ScreenSystemCompText" Text="COMP: LEN G49 RAD G40" FontFamily="Consolas"/>
                            </StackPanel>
                            <Grid x:Name="PosMetricsGrid" Grid.Row="1" Margin="0,1,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="21"/>
                                    <RowDefinition Height="20"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="182"/>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PART COUNT" Grid.Row="0" Grid.Column="1" FontFamily="Consolas" FontSize="10" Foreground="#FF0086A8" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <TextBlock Text="1" Grid.Row="0" Grid.Column="2" FontFamily="Consolas" FontSize="17" Foreground="#FF0094B8" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                                <TextBlock Text="RUN TIME" Grid.Row="1" Grid.Column="0" Style="{StaticResource ScreenInfoTextStyle}">
                                    <TextBlock.LayoutTransform><ScaleTransform ScaleX="0.4" ScaleY="0.4"/></TextBlock.LayoutTransform>
                                </TextBlock>
                                <TextBlock x:Name="ScreenRunTimeText" Text="0H  0M" Grid.Row="1" Grid.Column="1" Style="{StaticResource ScreenInfoTextStyle}">
                                    <TextBlock.LayoutTransform><ScaleTransform ScaleX="0.4" ScaleY="0.4"/></TextBlock.LayoutTransform>
                                </TextBlock>
                                <TextBlock Text="CYCLE TIME" Grid.Row="1" Grid.Column="2" Style="{StaticResource ScreenInfoTextStyle}">
                                    <TextBlock.LayoutTransform><ScaleTransform ScaleX="0.4" ScaleY="0.4"/></TextBlock.LayoutTransform>
                                </TextBlock>
                                <TextBlock x:Name="ScreenCycleTimeText" Text="0H  0M  0S" Grid.Row="1" Grid.Column="2" Style="{StaticResource ScreenInfoTextStyle}" HorizontalAlignment="Right">
                                    <TextBlock.LayoutTransform><ScaleTransform ScaleX="0.4" ScaleY="0.4"/></TextBlock.LayoutTransform>
                                </TextBlock>

                                <TextBlock Text="ACT.F" Grid.Row="2" Grid.Column="0" Style="{StaticResource ScreenInfoTextStyle}" FontSize="24">
                                    <TextBlock.LayoutTransform><ScaleTransform ScaleX="0.4" ScaleY="0.4"/></TextBlock.LayoutTransform>
                                </TextBlock>
                                <TextBlock x:Name="ScreenFeedText" Text="0 MM/MIN" Grid.Row="2" Grid.Column="1" Style="{StaticResource ScreenInfoTextStyle}" FontSize="24" Margin="-2,0,0,0">
                                    <TextBlock.LayoutTransform><ScaleTransform ScaleX="0.4" ScaleY="0.4"/></TextBlock.LayoutTransform>
                                </TextBlock>
                                <TextBlock x:Name="ScreenSpindleText"
                                           Text="S  0"
                                           Grid.Row="2"
                                           Grid.Column="2"
                                           Style="{StaticResource FanucMetricSpindleRpmDockStyle}"/>
                                <TextBlock x:Name="ScreenPosCoolantText"
                                           Text="L100%"
                                           Grid.Row="2"
                                           Grid.Column="2"
                                           Style="{StaticResource FanucMetricSpindleLoadDockStyle}"/>
                                <TextBlock x:Name="ScreenPosToolText" Text="TOOL: -" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#FFCCD0D7" BorderBrush="#FF3C4950" BorderThickness="2,0,2,2">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource FanucProgCyanBrush}" BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="1">
                            <TextBlock Text="◀" FontFamily="Consolas" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FF141414"/>
                        </Border>
                        <Border x:Name="SoftLblBorderSlot1" Grid.Column="1" Style="{StaticResource ScreenSoftLabelBorderStyle}"><TextBlock x:Name="SoftKeyLabel1" Text="ABS" Style="{StaticResource ScreenSoftLabelTextStyle}"/></Border>
                        <Border x:Name="SoftLblBorderSlot2" Grid.Column="2" Style="{StaticResource ScreenSoftLabelBorderStyle}"><TextBlock x:Name="SoftKeyLabel2" Text="REL" Style="{StaticResource ScreenSoftLabelTextStyle}"/></Border>
                        <Border x:Name="SoftLblBorderSlot3" Grid.Column="3" Style="{StaticResource ScreenSoftLabelBorderStyle}"><TextBlock x:Name="SoftKeyLabel3" Text="ALL" Style="{StaticResource ScreenSoftLabelTextStyle}"/></Border>
                        <Border x:Name="SoftLblBorderSlot4" Grid.Column="4" Style="{StaticResource ScreenSoftLabelBorderStyle}"><TextBlock x:Name="SoftKeyLabel4" Text="" Style="{StaticResource ScreenSoftLabelTextStyle}"/></Border>
                        <Border x:Name="SoftLblBorderSlot5" Grid.Column="5" Style="{StaticResource ScreenSoftLabelBorderStyle}"><TextBlock x:Name="SoftKeyLabel5" Text="OPRT" Style="{StaticResource ScreenSoftLabelTextStyle}"/></Border>
                        <Border x:Name="SoftLblBorderSlot6" Grid.Column="6" Style="{StaticResource ScreenSoftLabelBorderStyle}">
                            <TextBlock x:Name="SoftKeyLabel6" Text="" Style="{StaticResource ScreenSoftLabelTextStyle}"/>
                        </Border>
                    </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="#FFCCD0D7" BorderBrush="#FF3C4950" BorderThickness="2,0,2,0">
                    <Grid Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ScreenEditStatusText" Grid.Column="0" Text="EDIT**** *** ***" FontFamily="Consolas" FontSize="10" Foreground="#FF0E2A35" Margin="2,0,0,0" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#FFFA0000" BorderBrush="#FF8A0000" BorderThickness="1" Margin="4,0,4,0" Padding="0">
                            <TextBlock Text="--EMG--" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="2" Background="#FFFF0000" BorderBrush="#FFCC0000" BorderThickness="1" Margin="0,0,4,0" Padding="1,2,1,2" MinWidth="44">
                            <TextBlock Text="ALM" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock x:Name="ScreenStatusClockText"
                                       Text="16:28:33"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       Foreground="#FF0E2A35"
                                       VerticalAlignment="Center"/>
                            <Border Width="11"
                                    Height="11"
                                    Margin="8,1,4,1"
                                    BorderBrush="#FF6B7074"
                                    BorderThickness="1"
                                    Background="#FFCCD0D7"
                                    SnapsToDevicePixels="True"/>
                        </StackPanel>
                    </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="0" Background="#FF8F8F8F" BorderBrush="#FF5C5C5C" BorderThickness="2" Padding="8,8,8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="68"/>
                        <RowDefinition Height="84"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="6">
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="P&#10;O" Tag="P|O" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="Q&#10;N" Tag="Q|N" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="R&#10;G" Tag="R|G" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="A&#10;7" Tag="A|7" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="B&#10;8" Tag="B|8" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="C&#10;9" Tag="C|9" Click="MdiKey_Click"/>

                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="U&#10;X" Tag="U|X" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="V&#10;Y" Tag="V|Y" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="W&#10;Z" Tag="W|Z" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="&#9492;&#10;4" Tag="&#9492;|4" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="&#9496;&#10;5" Tag="&#9496;|5" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="SP&#10;6" Tag="SP|6" Click="MdiKey_Click"/>

                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="I&#10;M" Tag="I|M" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="J&#10;S" Tag="J|S" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="K&#10;T" Tag="K|T" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content=";&#10;1" Tag=";|1" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="#&#10;2" Tag="#|2" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="=&#10;3" Tag="=|3" Click="MdiKey_Click"/>

                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="L&#10;F" Tag="L|F" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="D&#10;H" Tag="D|H" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="E&#10;EOB" Tag="E|;" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="+ -" Tag="+|-" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="*&#10;0" Tag="*|0" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="/ ." Tag="/|." Click="MdiKey_Click"/>
                    </UniformGrid>

                    <UniformGrid Grid.Row="1" Columns="6" Margin="0,2,0,0">
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="POS" Click="PosPage_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="PROG" Click="ProgPage_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="OFS&#10;SET" Click="OffsetPage_Click"/>
                        <Button x:Name="MdiShiftButton" Style="{StaticResource MdiBeigeKeyStyle}" Content="SHIFT" Click="MdiShift_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="CAN" Click="MdiCan_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="INPUT" Click="MdiExec_Click"/>

                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="SYSTEM" Click="SystemPage_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="MESSAGE" Click="AlarmPage_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="CUSTOM&#10;GRPH" Click="DiagnPage_Click"/>
                        <Button x:Name="MdiAlterButton" Style="{StaticResource MdiBeigeKeyStyle}" Content="ALTER" Click="MdiAlter_Click"/>
                        <Button x:Name="MdiInsertButton" Style="{StaticResource MdiBeigeKeyStyle}" Content="INSERT" Click="MdiInsert_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="DELETE" Click="MdiDelete_Click"/>
                    </UniformGrid>

                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <!-- Matches first five columns of beige UniformGrid row; HELP/RESET in column six under DELETE -->
                        <Grid Grid.Column="0"
                              Grid.Row="0"
                              Grid.ColumnSpan="5"
                              Grid.RowSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42*"/>
                                <ColumnDefinition Width="52*"/>
                                <ColumnDefinition Width="52*"/>
                                <ColumnDefinition Width="52*"/>
                                <ColumnDefinition Width="40*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Column="0" Grid.Row="0" Style="{StaticResource MdiBeigeKeyStyle}" Width="40" Height="30" Content="PAGE&#10;&#8593;" Click="MdiPageUp_Click" FontSize="9" Padding="0,1,0,0"/>
                            <Button Grid.Column="0" Grid.Row="1" Style="{StaticResource MdiBeigeKeyStyle}" Width="40" Height="30" Content="PAGE&#10;&#8595;" Click="MdiPageDown_Click" FontSize="9" Padding="0,1,0,0"/>

                            <Button Grid.Column="2" Grid.Row="0" Style="{StaticResource MdiArrowKeyStyle}" Content="&#8593;" Click="MdiCursorUp_Click"/>
                            <Button Grid.Column="1" Grid.Row="1" Style="{StaticResource MdiArrowKeyStyle}" Content="&#8592;" Click="MdiCursorLeft_Click"/>
                            <Button Grid.Column="2" Grid.Row="1" Style="{StaticResource MdiArrowKeyStyle}" Content="&#8595;" Click="MdiCursorDown_Click"/>
                            <Button Grid.Column="3" Grid.Row="1" Style="{StaticResource MdiArrowKeyStyle}" Content="&#8594;" Click="MdiCursorRight_Click"/>
                        </Grid>

                        <Button Grid.Column="5"
                                Grid.Row="0"
                                Style="{StaticResource HelpResetKeyStyle}"
                                Background="{StaticResource KeyBeigeBrush}"
