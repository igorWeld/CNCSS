                                Grid.Row="1"
                                Style="{StaticResource HelpResetKeyStyle}"
                                Background="{StaticResource KeyWhiteBrush}"
                                BorderBrush="#FFB9B9B9"
                                Content="RESET"
                                Click="Reset_Click"
                                FontSize="9"
                                Foreground="#FF6F6F6F"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="0" Margin="0,1,0,0">
