<Window x:Class="CNCSS.UI.Dialogs.WcsQuickZeroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Быстрая установка WCS"
        Width="760"
        Height="440"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#FFB0B0B0"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/FanucPanelResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FanucCombo" TargetType="ComboBox">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#FF0F2A38"/>
                <Setter Property="BorderBrush" Value="#FF4A9EAF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#FF0F2A38"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="12"
            Background="{StaticResource FanucProgDisplayBrush}"
            BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
            BorderThickness="2"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Поле выбора WCS (как на референсе: большой индикатор + комбобокс) -->
                <Border Grid.Column="0"
                        BorderBrush="#FF3C4950"
                        BorderThickness="2"
                        Background="#FF1A2024"
                        Width="132"
                        Height="62"
                        Margin="0,0,10,0">
                    <Viewbox Stretch="Uniform" Margin="10,10,10,10">
                        <TextBlock x:Name="WcsIndicatorText"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   Foreground="#FFE8E8E8"
                                   Text="G54"/>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource FanucLabelStyle}" FontSize="12" Text="Поле выбора WCS"/>
                    <ComboBox x:Name="WcsCombo"
                              Width="92"
                              SelectedIndex="0"
                              SelectionChanged="WcsCombo_SelectionChanged"
                              Style="{StaticResource FanucCombo}">
                        <ComboBoxItem Content="G54"/>
                        <ComboBoxItem Content="G55"/>
                        <ComboBoxItem Content="G56"/>
                        <ComboBoxItem Content="G57"/>
                        <ComboBoxItem Content="G58"/>
                        <ComboBoxItem Content="G59"/>
                    </ComboBox>
                </StackPanel>

                <!-- Текущее смещение (ручной ввод) -->
                <Border Grid.Column="2"
                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource FanucProgDisplayBrush}"
                        Padding="10,8"
                        HorizontalAlignment="Right">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FanucLabelStyle}" FontSize="12" Margin="0,2,10,0" Text="Смещение"/>

                        <TextBlock Grid.Column="1" Style="{StaticResource FanucLabelStyle}" FontSize="12" Margin="0,2,4,0" Text="X"/>
                        <TextBox Grid.Column="2" x:Name="ManualX" Width="78" Margin="0,0,12,0" Style="{StaticResource FanucToolFieldTextBox}" Text="0.000"/>

                        <TextBlock Grid.Column="3" Style="{StaticResource FanucLabelStyle}" FontSize="12" Margin="0,2,4,0" Text="Y"/>
                        <TextBox Grid.Column="4" x:Name="ManualY" Width="78" Margin="0,0,12,0" Style="{StaticResource FanucToolFieldTextBox}" Text="0.000"/>

                        <TextBlock Grid.Column="5" Style="{StaticResource FanucLabelStyle}" FontSize="12" Margin="0,2,4,0" Text="Z"/>
                        <TextBox Grid.Column="6" x:Name="ManualZ" Width="78" Style="{StaticResource FanucToolFieldTextBox}" Text="0.000"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0" Margin="0,14,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource FanucProgDisplayBrush}">
                    <DockPanel Margin="10,8">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FanucLabelStyle}" FontSize="12" Margin="0,0,0,8" Text="Автоматическое смещение — Плоскость XY"/>
                        <StackPanel>
                            <RadioButton x:Name="XyCenter" Content="Центр заготовки" IsChecked="True"/>
                            <RadioButton x:Name="XyMaxMax" Content="Правый верхний угол (+X +Y)"/>
                            <RadioButton x:Name="XyMaxMin" Content="Правый нижний угол (+X -Y)"/>
                            <RadioButton x:Name="XyMinMax" Content="Левый верхний угол (-X +Y)"/>
                            <RadioButton x:Name="XyMinMin" Content="Левый нижний угол (-X -Y)"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="12,0,0,0"
                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource FanucProgDisplayBrush}">
                    <DockPanel Margin="10,8">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FanucLabelStyle}" FontSize="12" Margin="0,0,0,8" Text="Автоматическое смещение — Ось Z"/>
                        <StackPanel>
                            <RadioButton x:Name="ZTop" Content="Верх заготовки" IsChecked="True"/>
                            <RadioButton x:Name="ZBottom" Content="Низ заготовки"/>
                            <RadioButton x:Name="ZCenter" Content="Центр заготовки"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" VerticalAlignment="Top">
                <Button Content="Рассчитать"
                        Click="Compute_Click"
                        Style="{StaticResource FanucPanelButton}"
                        Padding="10,6"
                        Margin="0,0,0,10"/>
                <Button Content="Применить"
                        Click="Apply_Click"
                        Style="{StaticResource FanucConfirmButton}"
                        Padding="10,6"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#FF2A3A44"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <Button Content="Закрыть" Click="Close_Click" Style="{StaticResource FanucPanelButton}" Padding="10,6"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

