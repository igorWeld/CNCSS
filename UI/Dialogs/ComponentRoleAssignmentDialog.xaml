<Window x:Class="CNCSS.UI.Dialogs.ComponentRoleAssignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:CNCSS.UI.ViewModels"
        Title="Назначение компонентов сборки"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFB0B0B0">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/FanucPanelResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FanucToolCombo" TargetType="ComboBox">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#FF0F2A38"/>
                <Setter Property="BorderBrush" Value="{StaticResource FanucProgCyanBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="#FFFFFFFF"/>
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="MinHeight" Value="26"/>
            </Style>

            <Style x:Key="RoleStatusText" TargetType="TextBlock" BasedOn="{StaticResource FanucLabelStyle}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#FF0F4A54"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource FanucPanelButton}">
                <Setter Property="MinWidth" Value="110"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
            </Style>

            <Style x:Key="ComponentRowBorder" TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Background" Value="#FFFFFFFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource FanucProgCyanBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="PreviewHostBorder" TargetType="Border">
                <Setter Property="Width" Value="148"/>
                <Setter Property="Height" Value="148"/>
                <Setter Property="Background" Value="#FF1A2024"/>
                <Setter Property="BorderBrush" Value="#FF3C4950"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>

            <Style x:Key="ComponentNameText" TargetType="TextBlock" BasedOn="{StaticResource FanucLabelStyle}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="ComponentMetaText" TargetType="TextBlock" BasedOn="{StaticResource FanucLabelStyle}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#FF3C5866"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <DataTemplate DataType="{x:Type vm:ComponentRoleRowViewModel}">
                <Border Style="{StaticResource ComponentRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PreviewHostBorder}">
                            <hx:HelixViewport3D RotateGesture="RightClick"
                                                ZoomGesture="MiddleClick"
                                                ZoomExtentsWhenLoaded="True"
                                                ShowCoordinateSystem="False"
                                                ShowViewCube="False"
                                                Loaded="ComponentPreviewViewport_Loaded">
                                <hx:DefaultLights/>
                                <ModelVisual3D Content="{Binding PreviewModel}"/>
                            </hx:HelixViewport3D>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,4,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ComponentNameText}"/>
                            <TextBlock Text="{Binding TriangleSummary}" Style="{StaticResource ComponentMetaText}"/>
                            <TextBlock Text="Роль узла станка" Style="{StaticResource FanucLabelStyle}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource FanucToolCombo}"
                                      ItemsSource="{x:Static vm:ComponentRoleAssignmentViewModel.RoleOptions}"
                                      DisplayMemberPath="Title"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Role, Mode=OneWay}"
                                      SelectionChanged="RoleComboBox_SelectionChanged"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="10" Foreground="#FF6A7A82"
                                       Text="ПКМ — вращение, колесо — масштаб"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource FanucBezelOuter}">
        <Border Style="{StaticResource FanucBezelInner}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Background="#FFE8D400" SnapsToDevicePixels="True">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="FANUC" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#FFCC0000"/>
                </Grid>

                <Border Grid.Row="1" Margin="0,6,0,8"
                        Background="{StaticResource FanucProgCyanBrush}"
                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                        BorderThickness="1" Padding="16,5,16,7">
                    <StackPanel>
                        <TextBlock Text="MACHINE — назначение компонентов сборки"
                                   FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="#FF0F2A38"/>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                   FontFamily="Consolas" FontSize="11" Foreground="#FF0F4A54" Opacity="0.95">
                            <Run Text="Сборка содержит"/>
                            <Run Text="{Binding ComponentCount, Mode=OneWay}"/>
                            <Run Text="компонентов. Просмотрите превью и назначьте роли «Шпиндель», «Основание» и «Стол» — по одному разу."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource FanucColumnBorder}" Padding="10" Margin="4,0,4,4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding RoleStatus, Mode=OneWay}"
                                   Style="{StaticResource RoleStatusText}"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3" Margin="4,0,4,4"
                        Background="{StaticResource FanucProgDisplayBrush}"
                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                        BorderThickness="1" Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="11" Foreground="#FF3C5866"
                                   Text="Остальные детали — «Остальной узел». В каждой строке своё 3D-превью."/>
                        <Button Grid.Column="1" Content="Отмена" IsCancel="True" Click="Cancel_Click"
                                Style="{StaticResource FooterButton}"/>
                        <Button Grid.Column="2" Content="Применить" IsDefault="True"
                                IsEnabled="{Binding CanApply}"
                                Click="Apply_Click"
                                Style="{StaticResource FanucConfirmButton}"
                                MinWidth="120" Padding="12,5" Margin="6,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
