<Window x:Class="CNCSS.UI.Dialogs.StepImportQualityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Качество сетки STEP / IGES"
        Width="480"
        Height="360"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFB0B0B0">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/FanucPanelResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="QualityCombo" TargetType="ComboBox">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#FF0F2A38"/>
                <Setter Property="BorderBrush" Value="{StaticResource FanucProgCyanBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="#FFFFFFFF"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="MinHeight" Value="28"/>
            </Style>

            <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource FanucPanelButton}">
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource FanucBezelOuter}">
        <Border Style="{StaticResource FanucBezelInner}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Background="#FFE8D400" SnapsToDevicePixels="True">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="FANUC" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#FFCC0000"/>
                </Grid>

                <Border Grid.Row="1" Margin="0,6,0,8"
                        Background="{StaticResource FanucProgCyanBrush}"
                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                        BorderThickness="1" Padding="12,6,12,8">
                    <TextBlock Text="STEP / IGES — качество триангуляции"
                               FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#FF0F2A38"/>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource FanucColumnBorder}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Уровень детализации сетки"
                                   Style="{StaticResource FanucLabelStyle}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="QualityCombo"
                                  Style="{StaticResource QualityCombo}"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="QualityCombo_SelectionChanged"/>
                        <TextBlock x:Name="QualitySummaryText"
                                   Margin="0,10,0,0"
                                   FontFamily="Consolas" FontSize="11" Foreground="#FF0F4A54" FontWeight="Bold"/>
                        <TextBlock x:Name="QualityDescriptionText"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas" FontSize="11" Foreground="#FF3C5866"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Margin="0,8,0,0"
                        Background="{StaticResource FanucProgDisplayBrush}"
                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                        BorderThickness="1" Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="10" Foreground="#FF3C5866"
                                   Text="Применяется к следующей загрузке STEP/IGES"/>
                        <Button Grid.Column="1" Content="Отмена" IsCancel="True" Click="Cancel_Click"
                                Style="{StaticResource FooterButton}"/>
                        <Button Grid.Column="2" Content="OK" IsDefault="True" Click="Ok_Click"
                                Style="{StaticResource FanucConfirmButton}"
                                MinWidth="90" Padding="12,5" Margin="6,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
