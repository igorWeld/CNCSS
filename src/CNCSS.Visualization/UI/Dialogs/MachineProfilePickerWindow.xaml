<Window x:Class="CNCSS.UI.Dialogs.MachineProfilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор профиля станка"
        Width="420"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF2D2D30">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="ProfilesList"
                 DisplayMemberPath="."
                 Background="#FF1E1E1E"
                 Foreground="#FFE8E8E8"
                 BorderBrush="#FF555555"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Активировать" Click="Activate_Click" IsDefault="True" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="Настройка…" Click="Setup_Click" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="Закрыть" Click="Close_Click" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
