<Window x:Class="CNCSS.UI.Dialogs.StockConstructorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:h="http://helix-toolkit.org/wpf"
        mc:Ignorable="d"
        Title="Геометрические параметры заготовок"
        Width="1120"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFB0B0B0">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CNCSS.Visualization;component/UI/Themes/FanucPanelResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Local aliases to keep the window XAML readable -->
            <Style x:Key="PanelBorder" TargetType="Border" BasedOn="{StaticResource FanucColumnBorder}">
                <Setter Property="Padding" Value="10"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource FanucLabelStyle}">
                <Setter Property="FontStyle" Value="Italic"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FanucLabelStyle}">
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource FanucToolFieldTextBox}"/>

            <Style x:Key="FanucCombo" TargetType="ComboBox">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#FF0F2A38"/>
                <Setter Property="BorderBrush" Value="{StaticResource FanucProgCyanBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="#FFFFFFFF"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource FanucBezelOuter}">
        <Border Style="{StaticResource FanucBezelInner}">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: form -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="Тип проката" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Margin="4,0,0,0">
                                <RadioButton Content="Прямоугольный прокат" IsChecked="{Binding IsRectSelected}" Foreground="#FF0F2A38" FontFamily="Consolas"/>
                                <RadioButton Content="Шестигранный прокат" IsChecked="{Binding IsHexSelected}" Foreground="#FF0F2A38" FontFamily="Consolas"/>
                                <RadioButton Content="Круглый прокат" IsChecked="{Binding IsRoundSelected}" Foreground="#FF0F2A38" FontFamily="Consolas"/>
                                <RadioButton Content="Трубный прокат" IsChecked="{Binding IsTubeSelected}" Foreground="#FF0F2A38" FontFamily="Consolas"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding ShapeHeader}" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Param1Label}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Param1Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="мм" Style="{StaticResource FieldLabel}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Param2Label}" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding HasParam2, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Param2Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"
                                     Visibility="{Binding HasParam2, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="мм" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding HasParam2, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Param3Label}" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding HasParam3, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Param3Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"
                                     Visibility="{Binding HasParam3, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="мм" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding HasParam3, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Положение заготовки" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="X" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CenterXText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="мм" Style="{StaticResource FieldLabel}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Y" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CenterYText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="мм" Style="{StaticResource FieldLabel}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Отменить" Width="110" Margin="0,0,10,0" Style="{StaticResource FanucPanelButton}" Command="{Binding CancelCommand}"/>
                        <Button Content="Подтвердить" Width="130" Style="{StaticResource FanucConfirmButton}" Command="{Binding ApplyCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Right: preview -->
                <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Визуализация заготовки на столе станка"
                                   Style="{StaticResource SectionTitle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,6"/>

                        <Border Grid.Row="1"
                                BorderBrush="#FF3C4950"
                                BorderThickness="2"
                                Background="#FF1A2024"
                                Padding="2">
                            <h:HelixViewport3D x:Name="PreviewViewport"
                                               ZoomExtentsWhenLoaded="True"
                                               ShowCoordinateSystem="False"
                                               Background="#FF0F1418">
                                <h:HelixViewport3D.Camera>
                                    <PerspectiveCamera Position="220,220,190" LookDirection="-220,-220,-160" UpDirection="0,0,1" FieldOfView="45"/>
                                </h:HelixViewport3D.Camera>
                                <h:SunLight/>
                            </h:HelixViewport3D>
                        </Border>

                        <TextBlock Grid.Row="2" Text="{Binding ValidationSummary}"
                                   Foreground="#FFB71C1C"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Материал" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource FanucCombo}"
                                      ItemsSource="{Binding Materials}"
                                      SelectedItem="{Binding SelectedMaterial}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Column="3" Text="Цвет" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                            <StackPanel Grid.Column="4" Margin="8,0,0,0">
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel MaxWidth="360"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="24"
                                                    Height="24"
                                                    Margin="3"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="sw"
                                                                CornerRadius="1"
                                                                BorderBrush="#FF3C5866"
                                                                BorderThickness="1"
                                                                SnapsToDevicePixels="True">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding}"/>
                                                            </Border.Background>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="sw" Property="BorderBrush" Value="#FF0F4A54"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        MinWidth="170"
                                        Style="{StaticResource FanucPanelButton}"
                                        Content="Другой цвет…"
                                        Command="{Binding PickCustomColorCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>

