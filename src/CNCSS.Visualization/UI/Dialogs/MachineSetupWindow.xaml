<Window x:Class="CNCSS.UI.Dialogs.MachineSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        Title="Библиотека станков"
        Width="1440"
        Height="880"
        MinWidth="1200"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFB0B0B0"
        PreviewKeyDown="MachineSetupWindow_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CNCSS.Visualization;component/UI/Themes/FanucPanelResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ColTitle" TargetType="TextBlock" BasedOn="{StaticResource FanucLabelStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="PanelSection" TargetType="TextBlock" BasedOn="{StaticResource FanucLabelStyle}">
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock" BasedOn="{StaticResource FanucLabelStyle}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PanelTextBox" TargetType="TextBox" BasedOn="{StaticResource FanucToolFieldTextBox}">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PositionRotationHeader" TargetType="TextBlock" BasedOn="{StaticResource FanucLabelStyle}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PositionAxisLabel" TargetType="TextBlock" BasedOn="{StaticResource PanelLabel}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="PositionStackTextBoxTop" TargetType="TextBox" BasedOn="{StaticResource PanelTextBox}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PositionStackTextBoxMid" TargetType="TextBox" BasedOn="{StaticResource PositionStackTextBoxTop}">
            <Setter Property="BorderThickness" Value="1,0,1,0"/>
        </Style>
        <Style x:Key="PositionStackTextBoxBottom" TargetType="TextBox" BasedOn="{StaticResource PositionStackTextBoxTop}">
            <Setter Property="BorderThickness" Value="1,0,1,1"/>
        </Style>
        <Style x:Key="SidebarBtn" TargetType="Button" BasedOn="{StaticResource FanucPanelButton}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="IconToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource FanucPanelToggle}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style x:Key="FanucKeyButtonSmall" TargetType="Button" BasedOn="{StaticResource FanucPanelButton}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="22"/>
        </Style>
        <DataTemplate x:Key="MachineListItemTemplate">
            <TextBlock Text="{Binding DisplayName}" Margin="6,8" TextWrapping="Wrap"/>
        </DataTemplate>
        <DataTemplate x:Key="NodeListItemTemplate">
            <Border Padding="4,5" Margin="0,0,0,2" BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" Background="#FF1A2024"
                            BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="1" CornerRadius="2"/>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                               VerticalAlignment="Center" Margin="6,0,4,0" TextWrapping="Wrap"/>
                    <Button Grid.Column="2"
                            Width="24" Height="22" MinHeight="22" Padding="0"
                            Tag="{Binding}"
                            Click="NodeDisplayMode_Click"
                            Style="{StaticResource FanucPanelButton}"
                            ToolTip="Режим отображения узла: 👁 / ▦ / 🚫">
                        <TextBlock Text="{Binding DisplayGlyph}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="3" Content="Удалить" Tag="{Binding Id}" Click="NodeDelete_Click"
                            Style="{StaticResource FanucKeyButtonSmall}" VerticalAlignment="Center"
                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PositionVerticalTemplate">
            <StackPanel>
                <TextBlock Text="Положение (MCS, мм)" Style="{StaticResource PositionRotationHeader}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="56"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="X" Style="{StaticResource PositionAxisLabel}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="Y" Style="{StaticResource PositionAxisLabel}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="Z" Style="{StaticResource PositionAxisLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" IsTabStop="False"
                             Text="{Binding PositionMcsX, Mode=OneWay, StringFormat=F1}"
                             Style="{StaticResource PositionStackTextBoxTop}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" IsTabStop="False"
                             Text="{Binding PositionMcsY, Mode=OneWay, StringFormat=F1}"
                             Style="{StaticResource PositionStackTextBoxMid}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" IsTabStop="False"
                             Text="{Binding PositionMcsZ, Mode=OneWay, StringFormat=F1}"
                             Style="{StaticResource PositionStackTextBoxBottom}"/>
                </Grid>
                <TextBlock Text="Поворот" Style="{StaticResource PositionRotationHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="56"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="X" Style="{StaticResource PositionAxisLabel}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="Y" Style="{StaticResource PositionAxisLabel}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="Z" Style="{StaticResource PositionAxisLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding MeshRotationX, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PositionStackTextBoxTop}"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding MeshRotationY, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PositionStackTextBoxMid}"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding MeshRotationZ, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PositionStackTextBoxBottom}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="AxisLimitRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource FanucBezelOuter}">
        <Border Style="{StaticResource FanucBezelInner}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Background="#FFE8D400" SnapsToDevicePixels="True">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="FANUC" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#FFCC0000"/>
                </Grid>

                <Border Grid.Row="1" Margin="0,6,0,8"
                        Background="{StaticResource FanucProgCyanBrush}"
                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                        BorderThickness="1" Padding="16,5,16,7">
                    <StackPanel>
                        <TextBlock Text="MACHINE — библиотека станков"
                                   FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="#FF0F2A38"/>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                   FontFamily="Consolas" FontSize="11" Foreground="#FF0F4A54" Opacity="0.95"
                                   Text="Конфигурация узлов, осей и точек крепления. Профили сохраняются в папку с machine.json и 3D-моделями (STL, OBJ, STEP, IGES) для переноса на другой ПК."/>
                    </StackPanel>
                </Border>

    <Grid Grid.Row="2" Margin="4,0,4,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Библиотека станков -->
        <Border Grid.Column="0" Style="{StaticResource FanucColumnBorder}" Padding="8" Margin="0,0,4,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColTitle}">
                    <Run Text="Библиотека станков"/>
                    <LineBreak/>
                    <Run Text="{Binding ProfilesFolderPath, Mode=OneWay}" FontSize="10" FontWeight="Normal" Foreground="#FF3C5866"/>
                </TextBlock>
                <Button DockPanel.Dock="Bottom" Content="Загрузить станок" Click="LoadMachineProfile_Click"
                        Style="{StaticResource SidebarBtn}" Margin="0,4,0,0"
                        ToolTip="Импорт папки с machine.json и моделями (с другого ПК)"/>
                <Button DockPanel.Dock="Bottom" Content="Добавить станок" Click="NewProfile_Click"
                        Style="{StaticResource SidebarBtn}" Margin="0,8,0,0"/>
                <ListBox ItemsSource="{Binding MachineLibrary}"
                         SelectedValuePath="Id"
                         SelectedValue="{Binding SelectedProfileId, Mode=TwoWay}"
                         ItemTemplate="{StaticResource MachineListItemTemplate}"
                         Style="{StaticResource FanucListBox}"
                         ItemContainerStyle="{StaticResource FanucListBoxItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <!-- 2. Узлы -->
        <Border Grid.Column="1" Style="{StaticResource FanucColumnBorder}" Padding="8" Margin="0,0,4,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Узлы" Style="{StaticResource ColTitle}"/>
                <Button DockPanel.Dock="Bottom" Content="Загрузить сборку" Click="LoadMachineAssembly_Click"
                        Style="{StaticResource SidebarBtn}" Margin="0,4,0,0"
                        ToolTip="STL, OBJ или STEP AP203/AP214 (.stp) — несколько тел, назначение шпинделя, стола и основания"/>
                <Button DockPanel.Dock="Bottom" Content="Качество STEP…" Click="StepQualitySettings_Click"
                        Style="{StaticResource SidebarBtn}" Margin="0,4,0,0"
                        ToolTip="Детализация сетки при импорте STEP/IGES (Open CASCADE)"/>
                <TextBlock x:Name="StepQualitySummaryText" DockPanel.Dock="Bottom"
                           Margin="0,2,0,2" TextWrapping="Wrap"
                           FontFamily="Consolas" FontSize="10" Foreground="#FF3C5866"
                           Text="STEP: стандарт"/>
                <Button DockPanel.Dock="Bottom" Content="Добавить узел" Click="AddExtraNode_Click" Style="{StaticResource SidebarBtn}" Margin="0,8,0,0"/>
                <ListBox x:Name="NodeListBox"
                         ItemsSource="{Binding NodeTree}"
                         SelectedValuePath="Id"
                         SelectedValue="{Binding SelectedNodeId, Mode=TwoWay}"
                         ItemTemplate="{StaticResource NodeListItemTemplate}"
                         SelectionChanged="NodeListBox_SelectionChanged"
                         Style="{StaticResource FanucListBox}"
                         ItemContainerStyle="{StaticResource FanucListBoxItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <!-- 3. Зона модели станка -->
        <Border Grid.Column="2" Background="#FF3C4950" BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="2">
            <Grid x:Name="ModelZoneGrid"
                  PreviewMouseWheel="ModelZoneGrid_PreviewMouseWheel">
                <hx:HelixViewport3D x:Name="PreviewViewport"
                                    Background="#FF1A2024"
                                    RotateGesture="RightClick"
                                    ZoomAroundMouseDownPoint="True"
                                    ZoomExtentsWhenLoaded="False">
                    <hx:DefaultLights/>
                </hx:HelixViewport3D>

                <!-- Инструменты + ползунки (прозрачный фон, без рамки, вертикально) -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,8,0,0" IsHitTestVisible="True" Background="#00000000">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ToggleButton x:Name="AttachmentSpheresToggle" Style="{StaticResource IconToolToggle}"
                                      IsChecked="True"
                                      ToolTip="Сферы точек привязки (MCS, основание, стол, шпиндель)"
                                      Checked="AttachmentSpheresToggle_Changed" Unchecked="AttachmentSpheresToggle_Changed">
                            <TextBlock Text="●" FontSize="18" Foreground="#FFFFCC00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>
                        <ToggleButton x:Name="SymmetricToolToggle" Style="{StaticResource IconToolToggle}"
                                      ToolTip="Симметрия: 1–2) грани для середины, 3) деталь (центр по X или Y — по направлению между гранями). Esc — отмена."
                                      Checked="SymmetricToolToggle_Changed" Unchecked="SymmetricToolToggle_Changed">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="2" Canvas.Top="4" Width="8" Height="16" Stroke="#FF0F4A54" StrokeThickness="2"/>
                                    <Rectangle Canvas.Left="14" Canvas.Top="4" Width="8" Height="16" Stroke="#FF0F4A54" StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                        </ToggleButton>
                        <ToggleButton x:Name="AlignToolToggle" Style="{StaticResource IconToolToggle}"
                                      ToolTip="Совмещение: для MCS — клик сферы MCS, затем грань на станке; для узла — грань детали, затем опора. Esc — отмена."
                                      Checked="AlignToolToggle_Changed" Unchecked="AlignToolToggle_Changed">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="2" Canvas.Top="8" Width="10" Height="10" Stroke="#FF0F4A54" StrokeThickness="2"/>
                                    <Rectangle Canvas.Left="12" Canvas.Top="6" Width="10" Height="10" Stroke="#FF0F4A54" StrokeThickness="2" Fill="#550F4A54"/>
                                </Canvas>
                            </Viewbox>
                        </ToggleButton>
                    </StackPanel>
                    <TextBlock Text="Ползунки: поза осей в MCS (0 = ноль MCS)" Style="{StaticResource FanucLabelStyle}" FontSize="11" Margin="0,0,0,4" Foreground="#FFD1D7DC"/>
                    <Grid Width="260" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="X" Style="{StaticResource FanucLabelStyle}" Foreground="#FFD1D7DC" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="{Binding PreviewSliderXMinMcs}" Maximum="{Binding PreviewSliderXMaxMcs}" Value="{Binding PreviewXMcs}" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding PreviewXMcs, StringFormat=F0}" FontFamily="Consolas" Foreground="#FFFFCC00" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="260" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Y" Style="{StaticResource FanucLabelStyle}" Foreground="#FFD1D7DC" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="{Binding PreviewSliderYMinMcs}" Maximum="{Binding PreviewSliderYMaxMcs}" Value="{Binding PreviewYMcs}" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding PreviewYMcs, StringFormat=F0}" FontFamily="Consolas" Foreground="#FFFFCC00" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="260">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Z" Style="{StaticResource FanucLabelStyle}" Foreground="#FFD1D7DC" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="{Binding PreviewSliderZMinMcs}" Maximum="{Binding PreviewSliderZMaxMcs}" Value="{Binding PreviewZMcs}" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding PreviewZMcs, StringFormat=F0}" FontFamily="Consolas" Foreground="#FFFFCC00" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Margin="0,8,0,0" Padding="6" Background="#66000000" CornerRadius="2">
                        <StackPanel>
                            <CheckBox x:Name="PreviewWcsCheckBox" Content="Превью WCS (G54)" IsChecked="{Binding PreviewUseWcsCoordinateSystem, Mode=TwoWay}"
                                      Foreground="#FFD1D7DC" Margin="0,0,0,4"/>
                            <Grid Width="260">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="X" Foreground="#FFFF6666" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding PreviewWcsG54X, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}" Margin="4,2"/>
                                <TextBlock Grid.Column="2" Grid.Row="0" Text="G54" Foreground="#FF88AACC" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Y" Foreground="#FF66FF66" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding PreviewWcsG54Y, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}" Margin="4,2"/>
                                <TextBlock Grid.Row="2" Text="Z" Foreground="#FF66AAFF" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding PreviewWcsG54Z, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}" Margin="4,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxWidth="280" Margin="0,6,0,0"
                               FontSize="10" Foreground="#FFCCCCCC"/>
                </StackPanel>

                <!-- Окно станка (правый верхний угол) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                        Background="{StaticResource FanucProgDisplayBrush}"
                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="1" Padding="10" MinWidth="220">
                    <StackPanel>
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"
                                 Style="{StaticResource FanucToolFieldTextBox}"/>
                        <UniformGrid Columns="3">
                            <Button Content="Удалить" Click="DeleteProfile_Click" Style="{StaticResource FanucPanelButton}" Margin="0,0,2,0" Padding="6,4" FontSize="11"/>
                            <Button Content="Закрыть" Click="CloseWindow_Click" Style="{StaticResource FanucPanelButton}" Margin="2,0" Padding="6,4" FontSize="11"/>
                            <Button Content="Сохранить" Click="SaveProfile_Click" Style="{StaticResource FanucConfirmButton}" Margin="2,0,0,0" Padding="6,4" FontSize="11"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Плавающее модальное окно узла (перетаскивается за заголовок) -->
                <Border x:Name="NodeFloatingPanel"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="56,88,0,0" Width="500" MaxHeight="580"
                        Background="{StaticResource FanucProgDisplayBrush}" BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="2"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Border x:Name="NodePanelDragHandle" DockPanel.Dock="Top"
                                Background="{StaticResource FanucProgCyanBrush}" Padding="8,5"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="NodePanelDragHandle_MouseLeftButtonDown"
                                MouseMove="NodePanelDragHandle_MouseMove"
                                MouseLeftButtonUp="NodePanelDragHandle_MouseLeftButtonUp">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="NodePanelCollapseButton" Content="—" Style="{StaticResource FanucPanelButton}" Width="24" Height="22" MinHeight="22" Padding="0" Margin="0,0,4,0"
                                            Click="NodePanelCollapse_Click" ToolTip="Свернуть"/>
                                    <Button Content="✕" Style="{StaticResource FanucPanelButton}" Width="24" Height="22" MinHeight="22" Padding="0"
                                            Click="NodePanelClose_Click" ToolTip="Закрыть"/>
                                </StackPanel>
                                <TextBlock x:Name="NodeTitleText" Text="{Binding SelectedNodeDisplayName}" Foreground="#FF0F2A38" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" FontFamily="Consolas"/>
                                <TextBox x:Name="NodeTitleEdit" Text="{Binding SelectedExtraDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="Collapsed" VerticalAlignment="Center"
                                         Style="{StaticResource FanucToolFieldTextBox}" FontWeight="Bold" FontSize="13" MinWidth="140"/>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Background="{StaticResource FanucProgDisplayBrush}" Padding="0" BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Удалить" Click="DeleteSelectedNode_Click"
                                        Visibility="{Binding IsExtraNodeSelected, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource FanucPanelButton}" Margin="8,6,8,6" MinWidth="90"/>
                                <Button Grid.Column="1" Content="Загрузить модель" Click="LoadModelButton_Click"
                                        Style="{StaticResource FanucPanelButton}" Margin="0,6,0,6"/>
                                <Button Grid.Column="2" Content="Подтвердить" Click="ConfirmNodePanel_Click"
                                        Style="{StaticResource FanucConfirmButton}" Margin="0,6,6,6"/>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="NodePanelContent" VerticalScrollBarVisibility="Auto" Padding="0" Background="{StaticResource FanucProgDisplayBrush}">
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Левая колонка: положение и поворот -->
                                <Border Grid.Row="0" Grid.Column="0"
                                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="1" Padding="8,6"
                                        Background="#FFFFFFFF" VerticalAlignment="Top">
                                    <StackPanel>
                                        <StackPanel Visibility="{Binding IsBaseNodeSelected, Converter={StaticResource BoolToVis}}">
                                            <ContentControl Content="{Binding BaseNode}" ContentTemplate="{StaticResource PositionVerticalTemplate}"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsTableNodeSelected, Converter={StaticResource BoolToVis}}">
                                            <ContentControl Content="{Binding TableNode}" ContentTemplate="{StaticResource PositionVerticalTemplate}"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsSpindleNodeSelected, Converter={StaticResource BoolToVis}}">
                                            <ContentControl Content="{Binding SpindleNode}" ContentTemplate="{StaticResource PositionVerticalTemplate}"/>
                                        </StackPanel>
                                        <ContentControl x:Name="ExtraPositionHost"
                                                        Visibility="{Binding IsExtraNodeSelected, Converter={StaticResource BoolToVis}}"
                                                        ContentTemplate="{StaticResource PositionVerticalTemplate}"/>
                                        <Button Content="Точка привязки" Click="NodeAttachmentPoint_Click"
                                                Style="{StaticResource FanucPanelButton}" Margin="0,10,0,0"
                                                Padding="8,5" HorizontalAlignment="Stretch"
                                                ToolTip="Редактор точки привязки узла в 3D"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="1,0,0,0"/>

                                <!-- Правая колонка: оси и прочее -->
                                <StackPanel Grid.Row="0" Grid.Column="2" MinHeight="120">
                                    <!-- Цвет узла -->
                                    <Border BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="1" Background="#FFFFFFFF" Padding="8,6" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="Цвет" Style="{StaticResource PanelSection}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="Ø" Style="{StaticResource FanucPanelButton}" Width="26" Height="22" MinHeight="22" Padding="0"
                                                            Click="NodeColorDefault_Click" ToolTip="По умолчанию"/>
                                                    <Button Tag="#FFFFCC00" Width="18" Height="18" Background="#FFFFCC00" BorderBrush="#FF666666" BorderThickness="1" Margin="6,2,0,2" Click="NodeColorSwatch_Click"/>
                                                    <Button Tag="#FF3A86FF" Width="18" Height="18" Background="#FF3A86FF" BorderBrush="#FF666666" BorderThickness="1" Margin="4,2,0,2" Click="NodeColorSwatch_Click"/>
                                                    <Button Tag="#FF2ECC71" Width="18" Height="18" Background="#FF2ECC71" BorderBrush="#FF666666" BorderThickness="1" Margin="4,2,0,2" Click="NodeColorSwatch_Click"/>
                                                    <Button Tag="#FFE74C3C" Width="18" Height="18" Background="#FFE74C3C" BorderBrush="#FF666666" BorderThickness="1" Margin="4,2,0,2" Click="NodeColorSwatch_Click"/>
                                                    <Button Tag="#FF9B59B6" Width="18" Height="18" Background="#FF9B59B6" BorderBrush="#FF666666" BorderThickness="1" Margin="4,2,0,2" Click="NodeColorSwatch_Click"/>
                                                    <Button Tag="#FF34495E" Width="18" Height="18" Background="#FF34495E" BorderBrush="#FF666666" BorderThickness="1" Margin="4,2,0,2" Click="NodeColorSwatch_Click"/>
                                                    <Button Tag="#FF95A5A6" Width="18" Height="18" Background="#FF95A5A6" BorderBrush="#FF666666" BorderThickness="1" Margin="4,2,0,2" Click="NodeColorSwatch_Click"/>
                                                    <Button Tag="#FFFFFFFF" Width="18" Height="18" Background="#FFFFFFFF" BorderBrush="#FF666666" BorderThickness="1" Margin="4,2,0,2" Click="NodeColorSwatch_Click"/>
                                                    <Button Content="…" Style="{StaticResource FanucPanelButton}" Width="26" Height="22" MinHeight="22" Padding="0" Margin="6,0,0,0"
                                                            Click="NodeColorMore_Click" ToolTip="Выбрать цвет..."/>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Стол: оси перемещения + лимиты -->
                                    <Grid Visibility="{Binding IsTableNodeSelected, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Оси перемещения" Style="{StaticResource PanelSection}"/>
                                            <UniformGrid Columns="3" Margin="0,0,0,2">
                                                <TextBlock Text="X" Style="{StaticResource PanelLabel}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Y" Style="{StaticResource PanelLabel}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Z" Style="{StaticResource PanelLabel}" HorizontalAlignment="Center"/>
                                            </UniformGrid>
                                            <UniformGrid Columns="3">
                                                <CheckBox x:Name="TableMotionX" HorizontalAlignment="Center"
                                                          IsChecked="{Binding TableNode.MotionX, Mode=TwoWay}"
                                                          Checked="TableMotionX_Changed" Unchecked="TableMotionX_Changed"/>
                                                <CheckBox x:Name="TableMotionY" HorizontalAlignment="Center"
                                                          IsChecked="{Binding TableNode.MotionY, Mode=TwoWay}"
                                                          Checked="TableMotionY_Changed" Unchecked="TableMotionY_Changed"/>
                                                <CheckBox x:Name="TableMotionZ" HorizontalAlignment="Center"
                                                          IsChecked="{Binding TableNode.MotionZ, Mode=TwoWay}"
                                                          Checked="TableMotionZ_Changed" Unchecked="TableMotionZ_Changed"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                                <TextBlock Text="Перемещение по осям" Style="{StaticResource PanelSection}"/>
                                                <Grid Style="{StaticResource AxisLimitRow}" Visibility="{Binding TableNode.MotionX, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <TextBlock Text="X" Style="{StaticResource PanelLabel}"/>
                                                    <TextBlock Grid.Column="1" Text="max" Style="{StaticResource PanelLabel}"/>
                                                    <TextBlock Grid.Column="2" Text="min" Style="{StaticResource PanelLabel}"/>
                                                    <TextBlock Grid.Column="3" Text="home" Style="{StaticResource PanelLabel}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AxisXMaxMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding AxisXMinMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding AxisXHomeMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                </Grid>
                                                <Grid Style="{StaticResource AxisLimitRow}" Visibility="{Binding TableNode.MotionY, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <TextBlock Text="Y" Style="{StaticResource PanelLabel}"/>
                                                    <TextBlock Grid.Column="1" Text="max" Style="{StaticResource PanelLabel}"/>
                                                    <TextBlock Grid.Column="2" Text="min" Style="{StaticResource PanelLabel}"/>
                                                    <TextBlock Grid.Column="3" Text="home" Style="{StaticResource PanelLabel}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AxisYMaxMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding AxisYMinMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding AxisYHomeMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                </Grid>
                                                <Grid Style="{StaticResource AxisLimitRow}" Visibility="{Binding TableNode.MotionZ, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <TextBlock Text="Z" Style="{StaticResource PanelLabel}"/>
                                                    <TextBlock Grid.Column="1" Text="max" Style="{StaticResource PanelLabel}"/>
                                                    <TextBlock Grid.Column="2" Text="min" Style="{StaticResource PanelLabel}"/>
                                                    <TextBlock Grid.Column="3" Text="home" Style="{StaticResource PanelLabel}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AxisZMaxMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding AxisZMinMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding AxisZHomeMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Шпиндель: оси + лимиты (как на референсе — две колонки) -->
                                    <Grid Visibility="{Binding IsSpindleNodeSelected, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Оси перемещения" Style="{StaticResource PanelSection}"/>
                                            <UniformGrid Columns="3" Margin="0,0,0,2">
                                                <TextBlock Text="X" Style="{StaticResource PanelLabel}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Y" Style="{StaticResource PanelLabel}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Z" Style="{StaticResource PanelLabel}" HorizontalAlignment="Center"/>
                                            </UniformGrid>
                                            <UniformGrid Columns="3">
                                                <CheckBox x:Name="SpindleMotionX" HorizontalAlignment="Center"
                                                          IsChecked="{Binding SpindleNode.MotionX, Mode=TwoWay}"
                                                          Checked="SpindleMotionX_Changed" Unchecked="SpindleMotionX_Changed"/>
                                                <CheckBox x:Name="SpindleMotionY" HorizontalAlignment="Center"
                                                          IsChecked="{Binding SpindleNode.MotionY, Mode=TwoWay}"
                                                          Checked="SpindleMotionY_Changed" Unchecked="SpindleMotionY_Changed"/>
                                                <CheckBox x:Name="SpindleMotionZ" HorizontalAlignment="Center"
                                                          IsChecked="{Binding SpindleNode.MotionZ, Mode=TwoWay}"
                                                          Checked="SpindleMotionZ_Changed" Unchecked="SpindleMotionZ_Changed"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Перемещение по осям" Style="{StaticResource PanelSection}"/>
                                            <Grid Style="{StaticResource AxisLimitRow}" Visibility="{Binding SpindleNode.MotionX, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <TextBlock Text="X" Style="{StaticResource PanelLabel}"/>
                                                <TextBlock Grid.Column="1" Text="max" Style="{StaticResource PanelLabel}"/>
                                                <TextBlock Grid.Column="2" Text="min" Style="{StaticResource PanelLabel}"/>
                                                <TextBlock Grid.Column="3" Text="home" Style="{StaticResource PanelLabel}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AxisXMaxMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding AxisXMinMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding AxisXHomeMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                            </Grid>
                                            <Grid Style="{StaticResource AxisLimitRow}" Visibility="{Binding SpindleNode.MotionY, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <TextBlock Text="Y" Style="{StaticResource PanelLabel}"/>
                                                <TextBlock Grid.Column="1" Text="max" Style="{StaticResource PanelLabel}"/>
                                                <TextBlock Grid.Column="2" Text="min" Style="{StaticResource PanelLabel}"/>
                                                <TextBlock Grid.Column="3" Text="home" Style="{StaticResource PanelLabel}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AxisYMaxMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding AxisYMinMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding AxisYHomeMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                            </Grid>
                                            <Grid Style="{StaticResource AxisLimitRow}" Visibility="{Binding SpindleNode.MotionZ, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <TextBlock Text="Z" Style="{StaticResource PanelLabel}"/>
                                                <TextBlock Grid.Column="1" Text="max" Style="{StaticResource PanelLabel}"/>
                                                <TextBlock Grid.Column="2" Text="min" Style="{StaticResource PanelLabel}"/>
                                                <TextBlock Grid.Column="3" Text="home" Style="{StaticResource PanelLabel}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AxisZMaxMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding AxisZMinMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding AxisZHomeMcs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PanelTextBox}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Шпиндель: точка крепления инструмента (полоса на всю ширину) -->
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                        Visibility="{Binding IsSpindleNodeSelected, Converter={StaticResource BoolToVis}}"
                                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="1" Padding="12,10"
                                        Background="#FFFFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="TCP (MCS)"
                                                       Style="{StaticResource PanelSection}" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="X" Style="{StaticResource PanelLabel}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding ToolMountX, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PanelTextBox}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="Y" Style="{StaticResource PanelLabel}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="4" Text="{Binding ToolMountY, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PanelTextBox}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="Z" Style="{StaticResource PanelLabel}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="7" Text="{Binding ToolMountZ, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PanelTextBox}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Content="XY по центру модели"
                                                    Click="ToolMountCenterXyButton_Click"
                                                    Style="{StaticResource FanucPanelButton}"
                                                    Padding="12,6" MinWidth="168" MinHeight="34" FontSize="12"/>
                                            <ToggleButton x:Name="ToolMountPickZButton" Content="Задать Z"
                                                          Style="{StaticResource FanucPanelToggle}"
                                                          Checked="ToolMountPickZButton_Checked"
                                                          Unchecked="ToolMountPickZButton_Unchecked"
                                                          Padding="12,6" MinWidth="168" MinHeight="34" Margin="0,6,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Стол: плоскость оснастки и заготовки (на всю ширину окна) -->
                                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                        Visibility="{Binding IsTableNodeSelected, Converter={StaticResource BoolToVis}}"
                                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="1" Padding="12,10"
                                        Background="#FFFFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Плоскость установки оснастки и заготовки"
                                                   Style="{StaticResource PanelSection}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Z" Style="{StaticResource PanelLabel}" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding WorkpieceMountZ, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource PanelTextBox}" Width="72"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Задать плоскость"
                                                Click="WorkpiecePlaneButton_Click"
                                                Style="{StaticResource FanucPanelButton}"
                                                Padding="12,6" MinWidth="150" MinHeight="34"
                                                VerticalAlignment="Center" Margin="16,0,0,0"
                                                FontSize="13"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Плавающее окно точки привязки (сфера MCS / узел) -->
                <Border x:Name="AttachmentSphereFloatingPanel"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="580,88,0,0" Width="400" MaxHeight="560"
                        Background="{StaticResource FanucProgDisplayBrush}"
                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="2"
                        Visibility="Collapsed" Panel.ZIndex="2">
                    <DockPanel>
                        <Border x:Name="AttachmentSpherePanelDragHandle" DockPanel.Dock="Top"
                                Background="{StaticResource FanucProgCyanBrush}" Padding="8,5"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="AttachmentSpherePanelDragHandle_MouseLeftButtonDown"
                                MouseMove="AttachmentSpherePanelDragHandle_MouseMove"
                                MouseLeftButtonUp="AttachmentSpherePanelDragHandle_MouseLeftButtonUp">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource FanucPanelButton}"
                                        Width="24" Height="22" MinHeight="22" Padding="0"
                                        Click="AttachmentSpherePanelClose_Click" ToolTip="Закрыть"/>
                                <TextBlock x:Name="AttachmentSphereTitleText" Text="Точка привязки"
                                           Foreground="#FF0F2A38" FontWeight="Bold" FontSize="14"
                                           VerticalAlignment="Center" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Background="{StaticResource FanucProgDisplayBrush}"
                                Padding="0" BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="0,1,0,0">
                            <UniformGrid Columns="2" Margin="8,6">
                                <Button Content="Отмена" Click="AttachmentSpherePanelCancel_Click"
                                        Style="{StaticResource FanucPanelButton}" Margin="0,0,4,0" Padding="10,4"/>
                                <Button Content="Подтвердить" Click="AttachmentSpherePanelConfirm_Click"
                                        Style="{StaticResource FanucConfirmButton}" Margin="4,0,0,0" Padding="10,4"/>
                            </UniformGrid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8"
                                      Background="{StaticResource FanucProgDisplayBrush}">
                            <StackPanel>
                                <TextBlock x:Name="AttachmentSphereWorldHeader" Text="Мировые координаты WORLD (мм)" Style="{StaticResource PanelSection}"/>
                                <Border BorderBrush="{StaticResource FanucProgCyanBorderBrush}" BorderThickness="1"
                                        Background="#FFFFFFFF" Padding="8,6" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="0" Text="X" Style="{StaticResource PanelLabel}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Y" Style="{StaticResource PanelLabel}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Z" Style="{StaticResource PanelLabel}" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="AttachmentSphereWorldXBox" Grid.Row="1" Grid.Column="0"
                                                 Style="{StaticResource PanelTextBox}" TextAlignment="Center"
                                                 TextChanged="AttachmentSphereWorldCoords_TextChanged"/>
                                        <TextBox x:Name="AttachmentSphereWorldYBox" Grid.Row="1" Grid.Column="1"
                                                 Style="{StaticResource PanelTextBox}" TextAlignment="Center"
                                                 TextChanged="AttachmentSphereWorldCoords_TextChanged"/>
                                        <TextBox x:Name="AttachmentSphereWorldZBox" Grid.Row="1" Grid.Column="2"
                                                 Style="{StaticResource PanelTextBox}" TextAlignment="Center"
                                                 TextChanged="AttachmentSphereWorldCoords_TextChanged"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="AttachmentSphereNodePresetPanel" Margin="0,0,0,8">
                                    <TextBlock Text="Пресеты (локально в STL)" Style="{StaticResource PanelSection}"/>
                                    <Button Content="Верхний торец узла" Click="AttachmentSpherePresetTop_Click"
                                            Style="{StaticResource FanucPanelButton}" Margin="0,2" Padding="8,4"/>
                                    <Button Content="Нижний торец узла" Click="AttachmentSpherePresetBottom_Click"
                                            Style="{StaticResource FanucPanelButton}" Margin="0,2" Padding="8,4"/>
                                    <Button Content="По центру модели" Click="AttachmentSpherePresetCenter_Click"
                                            Style="{StaticResource FanucPanelButton}" Margin="0,2" Padding="8,4"/>
                                </StackPanel>

                                <StackPanel x:Name="AttachmentSphereMcsAlignPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                    <TextBlock Text="Выравнивание MCS" Style="{StaticResource PanelSection}"/>
                                    <Button Content="Выровнять MCS по центру всей модели станка"
                                            Click="AttachmentSphereMcsAlignCenter_Click"
                                            Style="{StaticResource FanucPanelButton}" Margin="0,2" Padding="8,4"/>
                                    <TextBlock Text="Узел для выравнивания:" Style="{StaticResource PanelLabel}" Margin="0,6,0,4"/>
                                    <ComboBox x:Name="AttachmentSphereMcsNodeCombo" DisplayMemberPath="DisplayName"
                                              Margin="0,0,0,4"/>
                                    <Button Content="Выбрать узел → по центру"
                                            Click="AttachmentSphereMcsAlignNodeCenter_Click"
                                            Style="{StaticResource FanucPanelButton}" Margin="0,2" Padding="8,4"/>
                                    <Button Content="Выбрать узел → верхний торец"
                                            Click="AttachmentSphereMcsAlignNodeTop_Click"
                                            Style="{StaticResource FanucPanelButton}" Margin="0,2" Padding="8,4"/>
                                    <Button Content="Выбрать узел → нижний торец"
                                            Click="AttachmentSphereMcsAlignNodeBottom_Click"
                                            Style="{StaticResource FanucPanelButton}" Margin="0,2" Padding="8,4"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
