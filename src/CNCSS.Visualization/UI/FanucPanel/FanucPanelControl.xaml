<UserControl x:Class="CNCSS.UI.FanucPanel.FanucPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="FanucPanelControl_PreviewKeyDown"
             Focusable="True"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top"
             MinWidth="600"
             MinHeight="368">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="KeyWhiteBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFCFCFC" Offset="0"/>
            <GradientStop Color="#FFE8E8E8" Offset="1"/>
        </LinearGradientBrush>
        <!-- 0i-MF PROG: единый серый экран (#D1D7DC); бирюзовые полосы #5BB2C3 (верхняя + ввод + вторая — одна палитра) -->
        <SolidColorBrush x:Key="FanucProgDisplayBrush" Color="#FFD1D7DC"/>
        <SolidColorBrush x:Key="FanucProgCyanBrush" Color="#FF5BB2C3"/>
        <SolidColorBrush x:Key="FanucProgCyanBorderBrush" Color="#FF4A9EAF"/>
        <LinearGradientBrush x:Key="KeyBeigeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF0E4C7" Offset="0"/>
            <GradientStop Color="#FFDCCCA1" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="FanucKeyBaseStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FF1A1A1A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border Margin="1" CornerRadius="4" BorderBrush="#66FFFFFF" BorderThickness="1,1,1,0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#FF9A9A9A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MdiWhiteKeyStyle" TargetType="Button" BasedOn="{StaticResource FanucKeyBaseStyle}">
            <Setter Property="Margin" Value="1.6"/>
            <Setter Property="Background" Value="{StaticResource KeyWhiteBrush}"/>
            <Setter Property="BorderBrush" Value="#FFB9B9B9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="MdiBeigeKeyStyle" TargetType="Button" BasedOn="{StaticResource MdiWhiteKeyStyle}">
            <Setter Property="Background" Value="{StaticResource KeyBeigeBrush}"/>
            <Setter Property="BorderBrush" Value="#FF9E947A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="MdiArrowKeyStyle" TargetType="Button" BasedOn="{StaticResource MdiWhiteKeyStyle}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="FanucMdiInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#FF0F2A38"/>
            <Setter Property="CaretBrush" Value="#FF0F2A38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="SoftKeyPhysicalButtonStyle" TargetType="Button" BasedOn="{StaticResource FanucKeyBaseStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFF2F2F2" Offset="0"/>
                        <GradientStop Color="#FFD2D2D2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#FFAEAEAE"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="HelpResetKeyStyle" TargetType="Button" BasedOn="{StaticResource FanucKeyBaseStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="1.6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="ScreenInfoTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="#FF0086A8"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- S и L%: единый стиль как в блоке метрик POS (RPM слева, нагрузка справа) -->
        <Style x:Key="FanucMetricSpindleRpmBaseStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="#FF202020"/>
            <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.45" ScaleY="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FanucMetricSpindleRpmDockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FanucMetricSpindleRpmBaseStyle}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <Style x:Key="FanucMetricSpindleLoadDockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FanucMetricSpindleRpmBaseStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="ScreenSoftLabelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFC7CBCE"/>
            <Setter Property="BorderBrush" Value="#FF53585C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ScreenSoftLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OffsetScreenTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF101010"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="OffsetScreenHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource OffsetScreenTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="OffsetScreenTealTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF0086A8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="OffsetTableCellStyle" TargetType="TextBlock" BasedOn="{StaticResource OffsetScreenTextStyle}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,1,2,1"/>
        </Style>
        <Style x:Key="OffsetToolValueCellStyle" TargetType="TextBlock" BasedOn="{StaticResource OffsetTableCellStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="OffsetToolValueCellBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="OffsetHighlightBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFE8D400"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
        <Style x:Key="OffsetWorkLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource OffsetScreenTextStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OffsetWorkValueBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFB8BEC6"/>
            <Setter Property="BorderBrush" Value="#FF7A828A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Padding" Value="3,0,2,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="OffsetWorkValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OffsetWorkLabelStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="OffsetWorkActiveSystemStyle" TargetType="TextBlock" BasedOn="{StaticResource OffsetScreenTextStyle}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="OffsetStatusFooterTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#FF0E2A35"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource FanucKeyBaseStyle}"/>
    </UserControl.Resources>

    <Border Background="#FF878787" BorderBrush="#FF656565" BorderThickness="2" Padding="10,8,10,7"
            HorizontalAlignment="Left">
        <Grid HorizontalAlignment="Left">
            <!-- FANUC panel reference proportions: fixed display + fixed MDI block, no horizontal stretch. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="456"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="296"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Background="#FF929292" BorderBrush="#FF5C5C5C" BorderThickness="2" Padding="7,7,7,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="254"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#FFE8D400" SnapsToDevicePixels="True">
                        <TextBlock Text="FANUC Series 0i-MF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="#FFCC0000"
                                   TextOptions.TextFormattingMode="Display"/>
                    </Grid>

                    <!-- Horizontal 21: рамка 2 + паддинг 9 + край строки программы 10 — одна база для PROGRAM/O N и строк G-кода -->
                    <Border Grid.Row="1"
                            Margin="0,1,0,0"
                            Background="{StaticResource FanucProgCyanBrush}"
                            BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                            BorderThickness="1,1,1,1"
                            Padding="18,5,18,5">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="ScreenRunStateText"
                                       DockPanel.Dock="Right"
                                       Text="00001 N00000"
                                       TextAlignment="Right"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="30"
                                       Foreground="#FF0F2A38"
                                       Margin="0"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0,0.5"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.LayoutTransform>
                                    <ScaleTransform ScaleX="0.39" ScaleY="0.39"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                            <TextBlock x:Name="ScreenModeText"
                                       Text="ACTUAL POSITION(ABSOLUTE)"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="30"
                                       Foreground="#FF0F2A38"
                                       Margin="0"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0,0.5"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.LayoutTransform>
                                    <ScaleTransform ScaleX="0.39" ScaleY="0.39"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource FanucProgDisplayBrush}"
                            BorderBrush="#FF3C4950"
                            BorderThickness="2"
                            Padding="8,3,8,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="174"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="PosCoordinateBorder"
                                    Grid.Row="0"
                                    BorderBrush="#FF000000"
                                    BorderThickness="1"
                                    Margin="0,3,0,2"
                                    Padding="7,4,6,2">
                                <Grid x:Name="PosPagePanel">
                                    <!-- ABS / REL big view -->
                                    <Grid x:Name="PosSingleGrid" Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48"/>
                                            <RowDefinition Height="48"/>
                                            <RowDefinition Height="48"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X" FontFamily="Consolas" FontSize="26" Foreground="#FF101010" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" FontFamily="Consolas" FontSize="26" Foreground="#FF101010" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" FontFamily="Consolas" FontSize="26" Foreground="#FF101010" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PosSingleXValueText" Grid.Row="0" Grid.Column="1" Text="-395.831" FontFamily="Consolas" FontSize="34" Foreground="#FF101010" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PosSingleYValueText" Grid.Row="1" Grid.Column="1" Text="-197.502" FontFamily="Consolas" FontSize="34" Foreground="#FF101010" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PosSingleZValueText" Grid.Row="2" Grid.Column="1" Text="-50.835" FontFamily="Consolas" FontSize="34" Foreground="#FF101010" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- ALL view: 4 blocks -->
                                    <Grid x:Name="PosAllGrid" Visibility="Collapsed" Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,6">
                                            <TextBlock Text="(RELATIVE)" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" Margin="0,0,0,2"/>
                                            <Border BorderBrush="#FF8C9298" BorderThickness="1" Background="Transparent" Padding="6,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock x:Name="PosAllRelXText" Grid.Row="0" Grid.Column="1" Text="-395.831" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                    <TextBlock x:Name="PosAllRelYText" Grid.Row="1" Grid.Column="1" Text="-197.502" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                    <TextBlock x:Name="PosAllRelZText" Grid.Row="2" Grid.Column="1" Text="-50.835" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                            <TextBlock Text="(ABSOLUTE)" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" Margin="0,0,0,2"/>
                                            <Border BorderBrush="#FF8C9298" BorderThickness="1" Background="Transparent" Padding="6,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock x:Name="PosAllAbsXText" Grid.Row="0" Grid.Column="1" Text="-395.831" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                    <TextBlock x:Name="PosAllAbsYText" Grid.Row="1" Grid.Column="1" Text="-197.502" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                    <TextBlock x:Name="PosAllAbsZText" Grid.Row="2" Grid.Column="1" Text="-50.835" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="(MACHINE)" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" Margin="0,0,0,2"/>
                                            <Border BorderBrush="#FF8C9298" BorderThickness="1" Background="Transparent" Padding="6,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock x:Name="PosAllMachXText" Grid.Row="0" Grid.Column="1" Text="-395.831" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                    <TextBlock x:Name="PosAllMachYText" Grid.Row="1" Grid.Column="1" Text="-197.502" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                    <TextBlock x:Name="PosAllMachZText" Grid.Row="2" Grid.Column="1" Text="-50.835" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="(DISTANCE TO GO)" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" Margin="0,0,0,2"/>
                                            <Border BorderBrush="#FF8C9298" BorderThickness="1" Background="Transparent" Padding="6,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" FontFamily="Consolas" FontSize="11" Foreground="#FF101010"/>
                                                    <TextBlock x:Name="PosAllDistXText" Grid.Row="0" Grid.Column="1" Text="0.000" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                    <TextBlock x:Name="PosAllDistYText" Grid.Row="1" Grid.Column="1" Text="0.000" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                    <TextBlock x:Name="PosAllDistZText" Grid.Row="2" Grid.Column="1" Text="0.000" FontFamily="Consolas" FontSize="11" Foreground="#FF101010" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- PROGRAM: бирюза как у верхней полосы; поле программы на том же сером что весь экран (#D1D7DC) -->
                            <Grid x:Name="ProgPageRoot"
                                  Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Visibility="Collapsed"
                                  Background="{StaticResource FanucProgDisplayBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="19"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Вторая полоса того же бирюза, но ниже по высоте: O справа/слева как на 0i-MF -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource FanucProgCyanBrush}"
                                        BorderBrush="{StaticResource FanucProgCyanBorderBrush}"
                                        BorderThickness="1,0,1,1"
                                        Padding="18,2,18,3"
                                        Margin="0">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock x:Name="ScreenProgFgTopStripeText"
                                                   DockPanel.Dock="Right"
                                                   Text="(FG:EDIT)"
                                                   FontFamily="Consolas"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FFF0F8FA"
                                                   TextOptions.TextFormattingMode="Display"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ScreenProgStripeOLeft"
                                                   DockPanel.Dock="Left"
                                                   Text="O0001"
                                                   FontFamily="Consolas"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FF0F2A38"
                                                   Margin="0,0,12,0"
                                                   Visibility="Collapsed"
                                                   TextOptions.TextFormattingMode="Display"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1"
                                      Margin="0,0,0,2"
                                      Background="Transparent"
                                      SnapsToDevicePixels="True">
