                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="D&#10;H" Tag="D|H" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="E&#10;EOB" Tag="E|;" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="+ -" Tag="+|-" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="*&#10;0" Tag="*|0" Click="MdiKey_Click"/>
                        <Button Style="{StaticResource MdiWhiteKeyStyle}" Content="/ ." Tag="/|." Click="MdiKey_Click"/>
                    </UniformGrid>

                    <UniformGrid Grid.Row="1" Columns="6" Margin="0,2,0,0">
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="POS" Click="PosPage_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="PROG" Click="ProgPage_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="OFS&#10;SET" Click="OffsetPage_Click"/>
                        <Button x:Name="MdiShiftButton" Style="{StaticResource MdiBeigeKeyStyle}" Content="SHIFT" Click="MdiShift_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="CAN" Click="MdiCan_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="INPUT" Click="MdiExec_Click"/>

                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="SYSTEM" Click="SystemPage_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="MESSAGE" Click="AlarmPage_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="CUSTOM&#10;GRPH" Click="DiagnPage_Click"/>
                        <Button x:Name="MdiAlterButton" Style="{StaticResource MdiBeigeKeyStyle}" Content="ALTER" Click="MdiAlter_Click"/>
                        <Button x:Name="MdiInsertButton" Style="{StaticResource MdiBeigeKeyStyle}" Content="INSERT" Click="MdiInsert_Click"/>
                        <Button Style="{StaticResource MdiBeigeKeyStyle}" Content="DELETE" Click="MdiDelete_Click"/>
                    </UniformGrid>

                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <!-- Matches first five columns of beige UniformGrid row; HELP/RESET in column six under DELETE -->
                        <Grid Grid.Column="0"
                              Grid.Row="0"
                              Grid.ColumnSpan="5"
                              Grid.RowSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42*"/>
                                <ColumnDefinition Width="52*"/>
                                <ColumnDefinition Width="52*"/>
                                <ColumnDefinition Width="52*"/>
                                <ColumnDefinition Width="40*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Column="0" Grid.Row="0" Style="{StaticResource MdiBeigeKeyStyle}" Width="40" Height="30" Content="PAGE&#10;&#8593;" Click="MdiPageUp_Click" FontSize="9" Padding="0,1,0,0"/>
                            <Button Grid.Column="0" Grid.Row="1" Style="{StaticResource MdiBeigeKeyStyle}" Width="40" Height="30" Content="PAGE&#10;&#8595;" Click="MdiPageDown_Click" FontSize="9" Padding="0,1,0,0"/>

                            <Button Grid.Column="2" Grid.Row="0" Style="{StaticResource MdiArrowKeyStyle}" Content="&#8593;" Click="MdiCursorUp_Click"/>
                            <Button Grid.Column="1" Grid.Row="1" Style="{StaticResource MdiArrowKeyStyle}" Content="&#8592;" Click="MdiCursorLeft_Click"/>
                            <Button Grid.Column="2" Grid.Row="1" Style="{StaticResource MdiArrowKeyStyle}" Content="&#8595;" Click="MdiCursorDown_Click"/>
                            <Button Grid.Column="3" Grid.Row="1" Style="{StaticResource MdiArrowKeyStyle}" Content="&#8594;" Click="MdiCursorRight_Click"/>
                        </Grid>

                        <Button Grid.Column="5"
                                Grid.Row="0"
                                Style="{StaticResource HelpResetKeyStyle}"
                                Background="{StaticResource KeyBeigeBrush}"
                                BorderBrush="#FF9B9278"
                                Content="HELP"
                                Click="Help_Click"/>
                        <Button Grid.Column="5"
                                Grid.Row="1"
                                Style="{StaticResource HelpResetKeyStyle}"
                                Background="{StaticResource KeyWhiteBrush}"
                                BorderBrush="#FFB9B9B9"
                                Content="RESET"
                                Click="Reset_Click"
                                FontSize="9"
                                Foreground="#FF6F6F6F"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="0" Margin="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Content="&#9664;" Click="SoftkeyPrev_Click" Margin="2,2"/>
                <Button Grid.Column="1" x:Name="SoftKeyButton1" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="2" x:Name="SoftKeyButton2" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="3" x:Name="SoftKeyButton3" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="4" x:Name="SoftKeyButton4" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="5" x:Name="SoftKeyButton5" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="6" x:Name="SoftKeyButton6" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Click="SoftKeyDynamic_Click" Margin="3,2"/>
                <Button Grid.Column="7" Style="{StaticResource SoftKeyPhysicalButtonStyle}" Content="&#9654;" Click="SoftkeyNext_Click" Margin="2,2"/>
            </Grid>

            <DockPanel x:Name="MdiInputRowPanel" Grid.Row="0" Grid.Column="0" Visibility="Collapsed"/>

            <StackPanel Visibility="Collapsed">
                <ComboBox x:Name="ModeComboBox" SelectionChanged="ModeComboBox_SelectionChanged"><ComboBoxItem Content="MEM" IsSelected="True"/></ComboBox>
                <TextBlock x:Name="JogLabelText"/>
                <ComboBox x:Name="JogStepComboBox" SelectionChanged="JogStepComboBox_SelectionChanged"><ComboBoxItem Content="1.0" IsSelected="True"/></ComboBox>
                <CheckBox x:Name="SingleBlockCheckBox" Checked="SingleBlockCheckBox_Changed" Unchecked="SingleBlockCheckBox_Changed"/>
                <CheckBox x:Name="OptionalStopCheckBox" Checked="OptionalStopCheckBox_Changed" Unchecked="OptionalStopCheckBox_Changed"/>
                <CheckBox x:Name="DryRunCheckBox" Checked="DryRunCheckBox_Changed" Unchecked="DryRunCheckBox_Changed"/>
                <ComboBox x:Name="OffsetSystemComboBox" SelectionChanged="OffsetSystemComboBox_SelectionChanged"><ComboBoxItem Content="G54" IsSelected="True"/></ComboBox>
                <TextBox x:Name="OffsetXTextBox" TextChanged="OffsetEditorField_TextChanged"/>
                <TextBox x:Name="OffsetYTextBox" TextChanged="OffsetEditorField_TextChanged"/>
                <TextBox x:Name="OffsetZTextBox" TextChanged="OffsetEditorField_TextChanged"/>
                <Button x:Name="OffsetApplyButton" Click="OffsetApply_Click"/>
                <Button Click="OffsetReadActive_Click"/>
                <Button Click="CycleStart_Click"/>
                <Button Click="FeedHold_Click"/>
                <Button Click="JogXPlus_Click"/>
                <Button Click="JogXMinus_Click"/>
                <Button Click="JogYPlus_Click"/>
                <Button Click="JogYMinus_Click"/>
                <Button Click="JogZPlus_Click"/>
                <Button Click="JogZMinus_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
