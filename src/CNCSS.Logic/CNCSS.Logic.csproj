<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net8.0-windows</TargetFramework>

    <UseWPF>true</UseWPF>

    <RootNamespace>CNCSS.Logic</RootNamespace>

    <AssemblyName>CNCSS.Logic</AssemblyName>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />

    <PackageReference Include="HelixToolkit.Wpf" Version="2.25.0" />

    <PackageReference Include="Occt.NET" Version="7.9.0" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\CNCSS.Data\CNCSS.Data.csproj" />

  </ItemGroup>

  <ItemGroup>

    <InternalsVisibleTo Include="CNCSS.Logic.Tests" />

    <InternalsVisibleTo Include="CNCSS.Tests" />

    <InternalsVisibleTo Include="CNCSS.Integration.Tests" />

  </ItemGroup>

  <Target Name="RemoveBrokenOcctConfigurationSource" BeforeTargets="CoreCompile">

    <ItemGroup>

      <Compile Remove="@(Compile)" Condition="$([System.String]::Copy('%(FullPath)').Contains('OcctConfiguration.cs'))" />

    </ItemGroup>

  </Target>

</Project>

