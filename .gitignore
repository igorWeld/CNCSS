```gitignore
# Test assemblies and build outputs
*.dll
*.exe
*.pdb
bin/
obj/
out/

# Dependencies
packages/
node_modules/
.nuget/
.npm/

# IDE files
.vs/
.vscode/
.idea/
*.userprefs
*.suo
*.user

# Logs
*.log

# Temporary files
*.tmp
*~
.DS_Store
Thumbs.db

# Configuration
*.user
*.local.settings.json

# Coverage and test results
TestResults/
coverage/
*.coverage
*.trx
```