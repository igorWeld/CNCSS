<Window x:Class="CNCSS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        xmlns:fanuc="clr-namespace:CNCSS.UI.FanucPanel;assembly=CNCSS.Visualization"
        xmlns:ops="clr-namespace:CNCSS.UI.OperatorStation;assembly=CNCSS.Visualization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CNCSS — 3D траектория"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CNCSS.Visualization;component/UI/Themes/FanucPanelResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!-- Fanuc-like filter icon toggle -->
            <Style x:Key="SceneFilterIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource FanucPanelToggle}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style x:Key="SceneFilterIconStroke" TargetType="Path">
                <Setter Property="Stroke" Value="#FF2F2F2F"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                        <Setter Property="Stroke" Value="#FF0F2A38"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SceneFilterIconFill" TargetType="Shape">
                <Setter Property="Fill" Value="#FF2F2F2F"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                        <Setter Property="Fill" Value="#FF0F2A38"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Открыть G-код..." Click="OpenFile_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Симуляция">
                <MenuItem Header="Программа..." Click="MenuProgramDialog_Click"/>
                <MenuItem Header="Инструмент..." Click="MenuToolsDialog_Click"/>
                <MenuItem Header="Заготовка">
                    <MenuItem Header="Конструктор заготовки…" Click="MenuStockDialog_Click"/>
                </MenuItem>
                <MenuItem Header="Быстрые действия">
                    <MenuItem Header="Установить ноль" Click="MenuQuickWcsZero_Click"/>
                    <MenuItem Header="Измерение инструмента" Click="MenuQuickMeasureTool_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Скорость">
                    <MenuItem Header="x2" Click="MenuSpeedPreset_Click" Tag="2"/>
                    <MenuItem Header="x5" Click="MenuSpeedPreset_Click" Tag="5"/>
                    <MenuItem Header="x9" Click="MenuSpeedPreset_Click" Tag="9"/>
                    <MenuItem Header="x15" Click="MenuSpeedPreset_Click" Tag="15"/>
                    <MenuItem Header="x20" Click="MenuSpeedPreset_Click" Tag="20"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Станок">
                <MenuItem Header="Настройка модели станка…" Click="MenuMachineSetup_Click"/>
                <MenuItem Header="Выбрать профиль станка…" Click="MenuMachineProfile_Click"/>
                <Separator/>
                <MenuItem Header="Сохранить текущие настройки как заводские" Click="MenuMachineSaveFactoryDefault_Click"/>
                <MenuItem Header="Сбросить заводской профиль" Click="MenuMachineFactoryReset_Click"/>
            </MenuItem>
            <MenuItem Header="_Окна">
                <MenuItem x:Name="MenuFanucWindowItem" Header="Стойка FANUC" IsCheckable="True" IsChecked="True"
                          Checked="MenuFanucWindowItem_Checked" Unchecked="MenuFanucWindowItem_Unchecked"/>
                <MenuItem x:Name="MenuOperatorPanelItem" Header="Панель оператора" IsCheckable="True" IsChecked="True"
                          Checked="MenuOperatorPanelItem_Checked" Unchecked="MenuOperatorPanelItem_Unchecked"/>
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="Подогнать камеру" Click="ZoomExtents_Click" InputGestureText="F"/>
            </MenuItem>
            <MenuItem Header="_Настройки">
                <MenuItem Header="Параметры симуляции">
                    <MenuItem.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Width="200" Margin="5">
                                <TextBlock Text="Ускоренная подача (G0):" Margin="0,0,0,2"/>
                                <TextBox x:Name="RapidFeedInputTop" Text="5000" Margin="0,0,0,10"/>

                                <TextBlock Text="Мин. сегментов дуги:" Margin="0,0,0,2"/>
                                <TextBox x:Name="ArcMinSegmentsInputTop" Text="8" Margin="0,0,0,10"/>

                                <TextBlock Text="Макс. сегментов дуги:" Margin="0,0,0,2"/>
                                <TextBox x:Name="ArcMaxSegmentsInputTop" Text="512" Margin="0,0,0,10"/>

                                <Button Content="Применить" Click="ApplySettingsTop_Click" Padding="5"/>
                            </StackPanel>
                        </DataTemplate>
                    </MenuItem.HeaderTemplate>
                </MenuItem>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#FF252526" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов" Margin="5,0"/>
            </StatusBarItem>
            <Separator Background="#40FFFFFF"/>
            <StatusBarItem>
                <TextBlock x:Name="RuntimeLoadText" Text="CPU: 0% | GPU: 0%" Margin="4,0" FontSize="11" Foreground="#FF9FD7FF"/>
            </StatusBarItem>
            <Separator Background="#40FFFFFF"/>
            <StatusBarItem>
                <TextBlock x:Name="VoxelResolutionStatusText" Text="Воксели: адаптивные (вкл.)" Margin="4,0" FontSize="11" Foreground="#FFCDE8FF"/>
            </StatusBarItem>
            <Separator Background="#40FFFFFF"/>
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Grid Width="300">
                    <ProgressBar x:Name="MainProgressBar" Height="14" Minimum="0" Maximum="100" Value="0" Background="#40FFFFFF" Foreground="SkyBlue" BorderThickness="0"/>
                    <TextBlock Text="{Binding ElementName=MainProgressBar, Path=Value, StringFormat={}{0:F0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 3D Viewport -->
            <hx:HelixViewport3D x:Name="Viewport"
                                Grid.Column="0"
                                Background="#FF1E1E1E"
                                ZoomExtentsWhenLoaded="True"
                                ShowCoordinateSystem="True">
                <hx:DefaultLights/>
            </hx:HelixViewport3D>

            <!-- Cycle Start / Stop (верхний левый угол viewport) -->
            <Border Grid.Column="0"
                    Panel.ZIndex="45"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="10,10,0,0"
                    Padding="6,6"
                    Background="#99000000"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ViewportCycleStartButton}"
                            Content="▶"
                            ToolTip="Cycle Start"
                            Click="ViewportCycleStart_Click"/>
                    <Button Style="{StaticResource ViewportCycleStopButton}"
                            Content="■"
                            Margin="6,0,0,0"
                            ToolTip="Cycle Stop"
                            Click="ViewportCycleStop_Click"/>
                </StackPanel>
            </Border>


            <!-- Left-side scene filters (Fanuc style, no panel background) -->
            <StackPanel Grid.Column="0"
                        Panel.ZIndex="40"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="10,0,0,0">
                    <!-- Order like SprutCAM toolbar -->
                    <!-- 1) Toolpath -->
                    <ToggleButton x:Name="FilterShowToolpath" Style="{StaticResource SceneFilterIconToggle}" IsChecked="True"
                                  Checked="SceneFilter_Changed" Unchecked="SceneFilter_Changed"
                                  ToolTip="Показывать траектории движения">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource SceneFilterIconStroke}" Data="M2,18 C6,7 10,21 14,10 C16,5 20,9 22,4"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <!-- 2) Machine (base + table + spindle + extras) -->
                    <ToggleButton x:Name="FilterShowMachine" Style="{StaticResource SceneFilterIconToggle}" IsChecked="True"
                                  Checked="SceneFilter_Changed" Unchecked="SceneFilter_Changed"
                                  ToolTip="Станок">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <!-- Simple "machine" glyph: base + column + head -->
                                <Rectangle Width="18" Height="5" Canvas.Left="3" Canvas.Top="17" Style="{StaticResource SceneFilterIconFill}"/>
                                <Rectangle Width="6" Height="10" Canvas.Left="9" Canvas.Top="7" Style="{StaticResource SceneFilterIconFill}"/>
                                <Rectangle Width="10" Height="4" Canvas.Left="7" Canvas.Top="4" Style="{StaticResource SceneFilterIconFill}"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <!-- 3) Stock / part -->
                    <ToggleButton x:Name="FilterShowStock" Style="{StaticResource SceneFilterIconToggle}" IsChecked="False"
                                  Checked="SceneFilter_Changed" Unchecked="SceneFilter_Changed"
                                  ToolTip="Показывать заготовку">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource SceneFilterIconStroke}" Data="M6,9 L12,5 L18,9 L12,13 Z"/>
                                <Path Style="{StaticResource SceneFilterIconStroke}" Data="M6,9 L6,16 L12,20 L12,13"/>
                                <Path Style="{StaticResource SceneFilterIconStroke}" Data="M18,9 L18,16 L12,20"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <!-- Tool (similar style) -->
                    <ToggleButton x:Name="FilterShowTool" Style="{StaticResource SceneFilterIconToggle}" IsChecked="True"
                                  Checked="SceneFilter_Changed" Unchecked="SceneFilter_Changed"
                                  ToolTip="Показывать инструмент">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource SceneFilterIconStroke}" Data="M12,3 L12,14"/>
                                <Path Style="{StaticResource SceneFilterIconStroke}" Data="M9,14 L15,14 L13,21 L11,21 Z"/>
                                <Path Style="{StaticResource SceneFilterIconStroke}" Data="M10,16 L14,16"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <!-- Adaptive LOD proximity cylinder -->
                    <ToggleButton x:Name="FilterShowAdaptiveProximity" Style="{StaticResource SceneFilterIconToggle}" IsChecked="False"
                                  Checked="SceneFilter_Changed" Unchecked="SceneFilter_Changed"
                                  ToolTip="Зона адаптивной точности (цилиндр +20%)">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource SceneFilterIconStroke}" Data="M7,7 A5,2 0 1,0 17,7"/>
                                <Path Style="{StaticResource SceneFilterIconStroke}" Data="M7,17 A5,2 0 1,0 17,17"/>
                                <Path Style="{StaticResource SceneFilterIconStroke}" Data="M7,7 L7,17 M17,7 L17,17"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
            </StackPanel>

            <!-- Floating panels over 3D (FANUC last = on top). -->
            <Canvas Grid.Column="0" Panel.ZIndex="50" IsHitTestVisible="True">
                <Border x:Name="OperatorFloatingHost"
                        Canvas.Left="28"
                        Canvas.Top="260"
                        MinWidth="346"
                        MinHeight="285"
                        Background="#DD1F1F1F"
                        BorderBrush="#FF6A6A6A"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*" MinHeight="0"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="OperatorFloatingHeader"
                                Grid.Row="0"
                                Height="34"
                                Background="#FF383C42"
                                CornerRadius="6,6,0,0"
                                MouseLeftButtonDown="OperatorFloatingHeader_MouseLeftButtonDown"
                                MouseMove="OperatorFloatingHeader_MouseMove"
                                MouseLeftButtonUp="OperatorFloatingHeader_MouseLeftButtonUp">
                            <DockPanel LastChildFill="False" Margin="8,0">
                                <TextBlock Text="Управление станком"
                                           DockPanel.Dock="Left"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                                <Button x:Name="OperatorMinimizeButton"
                                        DockPanel.Dock="Right"
                                        Width="24"
                                        Height="22"
                                        Margin="4,0,0,0"
                                        Content="_"
                                        Click="OperatorMinimizeButton_Click"
                                        ToolTip="Свернуть / развернуть"/>
                                <Button x:Name="OperatorResetSizeButton"
                                        DockPanel.Dock="Right"
                                        Width="24"
                                        Height="22"
                                        Margin="0,0,0,0"
                                        Content="&#x21BA;"
                                        FontSize="14"
                                        Padding="0"
                                        Click="OperatorResetSizeButton_Click"
                                        ToolTip="Размер по умолчанию"/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="OperatorFloatingContent" Grid.Row="1" Background="#FF0F0F0F" HorizontalAlignment="Stretch" ClipToBounds="True">
                            <ScrollViewer x:Name="OperatorContentScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0"
                                          Background="#FF0F0F0F">
                                <ops:OperatorStationPanel x:Name="OperatorPanel" Margin="4" HorizontalAlignment="Stretch">
                                    <ops:OperatorStationPanel.LayoutTransform>
                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                    </ops:OperatorStationPanel.LayoutTransform>
                                </ops:OperatorStationPanel>
                            </ScrollViewer>
                        </Border>
                        <!-- Поверх всего окна, чтобы захват всегда в углу хоста, а не строки контента -->
                        <Thumb x:Name="OperatorResizeThumb"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               Width="20"
                               Height="20"
                               Margin="0,0,1,1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Panel.ZIndex="10"
                               Cursor="SizeNWSE"
                               DragDelta="OperatorResizeThumb_DragDelta"
                               ToolTip="Изменить размер">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="#66FFD700" BorderBrush="#CCFFFFFF" BorderThickness="1" CornerRadius="2"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
                <Border x:Name="FanucFloatingHost"
                        Canvas.Left="24"
                        Canvas.Top="24"
                        MinWidth="640"
                        MinHeight="440"
                        Background="#DD1F1F1F"
                        BorderBrush="#FF6A6A6A"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*" MinHeight="0"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="FanucFloatingHeader"
                                Grid.Row="0"
                                Height="34"
                                Background="#FF2D2D30"
                                CornerRadius="6,6,0,0"
                                MouseLeftButtonDown="FanucFloatingHeader_MouseLeftButtonDown"
                                MouseMove="FanucFloatingHeader_MouseMove"
                                MouseLeftButtonUp="FanucFloatingHeader_MouseLeftButtonUp">
                            <DockPanel LastChildFill="False" Margin="8,0">
                                <TextBlock Text="FANUC 0i-MF Plus"
                                           DockPanel.Dock="Left"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                                <Button x:Name="FanucMinimizeButton"
                                        DockPanel.Dock="Right"
                                        Width="24"
                                        Height="22"
                                        Margin="4,0,0,0"
                                        Content="_"
                                        Click="FanucMinimizeButton_Click"
                                        ToolTip="Свернуть / развернуть"/>
                                <Button x:Name="FanucResetSizeButton"
                                        DockPanel.Dock="Right"
                                        Width="24"
                                        Margin="0,0,0,0"
                                        Content="&#x21BA;"
                                        FontSize="14"
                                        Padding="0"
                                        Click="FanucResetSizeButton_Click"
                                        ToolTip="Размер по умолчанию"/>
                            </DockPanel>
                        </Border>

                        <Border x:Name="FanucFloatingContent" Grid.Row="1" Background="#FF0F0F0F" ClipToBounds="True" HorizontalAlignment="Stretch">
                            <ScrollViewer x:Name="FanucContentScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0"
                                          Background="#FF0F0F0F">
                                <fanuc:FanucPanelControl x:Name="FanucPanel" Margin="6" HorizontalAlignment="Stretch" Loaded="FanucPanel_Loaded"/>
                            </ScrollViewer>
                        </Border>

                        <Thumb x:Name="FanucResizeThumb"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               Width="20"
                               Height="20"
                               Margin="0,0,1,1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Panel.ZIndex="10"
                               Cursor="SizeNWSE"
                               DragDelta="FanucResizeThumb_DragDelta"
                               ToolTip="Изменить размер">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="#66FFD700" BorderBrush="#CCFFFFFF" BorderThickness="1" CornerRadius="2"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
            </Canvas>

            <!-- FPS + Stock stats (Top Right) -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Margin="10"
                        IsHitTestVisible="False">
                <Border Padding="8,4"
                        Background="#80000000"
                        CornerRadius="4"
                        Margin="0,0,0,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FPS: " Foreground="White" FontSize="12"/>
                            <TextBlock x:Name="FpsText" Text="0" Foreground="Lime" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock x:Name="ChunkStatsText" Text="Cut: - | Render: -" Foreground="#CCFFFFFF" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="StockStatsPanel"
                        Padding="10,6"
                        Background="#B0101010"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                    <StackPanel MinWidth="180">
                        <TextBlock Text="Заготовка" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="StockStatsSizeText" Text="Размер: —" Foreground="#E6FFFFFF" FontSize="11"/>
                        <TextBlock x:Name="StockStatsBricksText" Text="Кирпичи: —" Foreground="#E6FFFFFF" FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock x:Name="StockStatsVoxelsText" Text="Воксели: —" Foreground="#E6FFFFFF" FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock x:Name="StockStatsPrecisionText" Text="Точность: —" Foreground="#E6FFFFFF" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Overlay Panel (Bottom Left) -->
            <Border Grid.Column="0" 
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Left" 
                    Margin="20" 
                    Padding="15"
                    Background="#80000000" 
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ToolText" Text="Инструмент: -" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="CoordSystemText" Text="СК: G54" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="RefSystemText" Text="Отсчет: ABS" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="PositionText" Text="X: 0.000 Y: 0.000 Z: 0.000" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,5,0,2"/>
                    <TextBlock x:Name="FeedStatusText" Text="F: 0 мм/мин" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="SpindleStatusText" Text="S: 0 об/мин (M5)" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="CoolantText" Text="СОЖ: ВЫКЛ" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="ResolutionStatusText" Text="Воксели: адаптивные (вкл.)" Foreground="White" FontSize="14" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- Central Progress Bar Panel -->
            <Border Grid.Column="0" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="20,15"
                    Background="#D0000000"
                    CornerRadius="12"
                    x:Name="StockProgressPanel"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Расчет воксельной модели..."
                               Foreground="SkyBlue"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StockProgressText"
                               Text="0 / 0 чанков"
                               Foreground="SkyBlue"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="StockProgressBar"
                                 Height="8"
                                 Width="300"
                                 Minimum="0"
                                 Maximum="100"
                                 IsIndeterminate="True"
                                 Foreground="SkyBlue"
                                 Background="#40FFFFFF"
                                 BorderThickness="0"/>
                    <TextBlock x:Name="StockLoadText"
                               Text="CPU: 0% | GPU: 0%"
                               Foreground="#B0CDE8FF"
                               FontSize="10"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
