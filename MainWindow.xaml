<Window x:Class="CNCSS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        xmlns:fanuc="clr-namespace:CNCSS.UI.FanucPanel"
        xmlns:ops="clr-namespace:CNCSS.UI.OperatorStation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CNCSS — 3D траектория"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Открыть G-код..." Click="OpenFile_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Симуляция">
                <MenuItem Header="Программа..." Click="MenuProgramDialog_Click"/>
                <MenuItem Header="Инструмент..." Click="MenuToolsDialog_Click"/>
                <MenuItem Header="Заготовка..." Click="MenuStockDialog_Click"/>
                <Separator/>
                <MenuItem Header="Скорость">
                    <MenuItem Header="x2" Click="MenuSpeedPreset_Click" Tag="2"/>
                    <MenuItem Header="x5" Click="MenuSpeedPreset_Click" Tag="5"/>
                    <MenuItem Header="x9" Click="MenuSpeedPreset_Click" Tag="9"/>
                    <MenuItem Header="x15" Click="MenuSpeedPreset_Click" Tag="15"/>
                    <MenuItem Header="x20" Click="MenuSpeedPreset_Click" Tag="20"/>
                </MenuItem>
                <MenuItem Header="Заготовка" Visibility="Collapsed">
                    <MenuItem x:Name="MenuStockVisibleItem" Header="Показывать заготовку" IsCheckable="True" IsChecked="True" Click="MenuStockVisible_Click"/>
                    <Separator/>
                    <MenuItem Header="Точность: высокая" Click="MenuResolution_Click" Tag="0.1"/>
                    <MenuItem Header="Точность: средняя" Click="MenuResolution_Click" Tag="0.3"/>
                    <MenuItem Header="Точность: грубая" Click="MenuResolution_Click" Tag="0.6"/>
                    <Separator/>
                    <MenuItem Header="Применить параметры заготовки" Click="ApplyStock_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Окна">
                <MenuItem x:Name="MenuFanucWindowItem" Header="Стойка FANUC" IsCheckable="True" IsChecked="True"
                          Checked="MenuFanucWindowItem_Checked" Unchecked="MenuFanucWindowItem_Unchecked"/>
                <MenuItem x:Name="MenuOperatorPanelItem" Header="Панель оператора" IsCheckable="True" IsChecked="True"
                          Checked="MenuOperatorPanelItem_Checked" Unchecked="MenuOperatorPanelItem_Unchecked"/>
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="Подогнать камеру" Click="ZoomExtents_Click" InputGestureText="F"/>
            </MenuItem>
            <MenuItem Header="_Настройки">
                <MenuItem Header="Параметры симуляции">
                    <MenuItem.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Width="200" Margin="5">
                                <TextBlock Text="Ускоренная подача (G0):" Margin="0,0,0,2"/>
                                <TextBox x:Name="RapidFeedInputTop" Text="5000" Margin="0,0,0,10"/>

                                <TextBlock Text="Мин. сегментов дуги:" Margin="0,0,0,2"/>
                                <TextBox x:Name="ArcMinSegmentsInputTop" Text="8" Margin="0,0,0,10"/>

                                <TextBlock Text="Макс. сегментов дуги:" Margin="0,0,0,2"/>
                                <TextBox x:Name="ArcMaxSegmentsInputTop" Text="512" Margin="0,0,0,10"/>

                                <Button Content="Применить" Click="ApplySettingsTop_Click" Padding="5"/>
                            </StackPanel>
                        </DataTemplate>
                    </MenuItem.HeaderTemplate>
                </MenuItem>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#FF252526" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов" Margin="5,0"/>
            </StatusBarItem>
            <Separator Background="#40FFFFFF"/>
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Grid Width="300">
                    <ProgressBar x:Name="MainProgressBar" Height="14" Minimum="0" Maximum="100" Value="0" Background="#40FFFFFF" Foreground="SkyBlue" BorderThickness="0"/>
                    <TextBlock Text="{Binding ElementName=MainProgressBar, Path=Value, StringFormat={}{0:F0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 3D Viewport -->
            <hx:HelixViewport3D x:Name="Viewport"
                                Grid.Column="0"
                                Background="#FF1E1E1E"
                                ZoomExtentsWhenLoaded="True"
                                ShowCoordinateSystem="True">
                <hx:DefaultLights/>
            </hx:HelixViewport3D>

            <!-- Floating panels over 3D (FANUC last = on top). -->
            <Canvas Grid.Column="0" Panel.ZIndex="50" IsHitTestVisible="True">
                <Border x:Name="OperatorFloatingHost"
                        Canvas.Left="28"
                        Canvas.Top="260"
                        MinWidth="346"
                        MinHeight="285"
                        Background="#DD1F1F1F"
                        BorderBrush="#FF6A6A6A"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*" MinHeight="0"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="OperatorFloatingHeader"
                                Grid.Row="0"
                                Height="34"
                                Background="#FF383C42"
                                CornerRadius="6,6,0,0"
                                MouseLeftButtonDown="OperatorFloatingHeader_MouseLeftButtonDown"
                                MouseMove="OperatorFloatingHeader_MouseMove"
                                MouseLeftButtonUp="OperatorFloatingHeader_MouseLeftButtonUp">
                            <DockPanel LastChildFill="False" Margin="8,0">
                                <TextBlock Text="Управление станком"
                                           DockPanel.Dock="Left"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                                <Button x:Name="OperatorMinimizeButton"
                                        DockPanel.Dock="Right"
                                        Width="24"
                                        Height="22"
                                        Margin="4,0,0,0"
                                        Content="_"
                                        Click="OperatorMinimizeButton_Click"
                                        ToolTip="Свернуть / развернуть"/>
                                <Button x:Name="OperatorResetSizeButton"
                                        DockPanel.Dock="Right"
                                        Width="24"
                                        Height="22"
                                        Margin="0,0,0,0"
                                        Content="&#x21BA;"
                                        FontSize="14"
                                        Padding="0"
                                        Click="OperatorResetSizeButton_Click"
                                        ToolTip="Размер по умолчанию"/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="OperatorFloatingContent" Grid.Row="1" Background="#FF0F0F0F" HorizontalAlignment="Stretch" ClipToBounds="True">
                            <ScrollViewer x:Name="OperatorContentScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0"
                                          Background="#FF0F0F0F">
                                <ops:OperatorStationPanel x:Name="OperatorPanel" Margin="4" HorizontalAlignment="Stretch">
                                    <ops:OperatorStationPanel.LayoutTransform>
                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                    </ops:OperatorStationPanel.LayoutTransform>
                                </ops:OperatorStationPanel>
                            </ScrollViewer>
                        </Border>
                        <!-- Поверх всего окна, чтобы захват всегда в углу хоста, а не строки контента -->
                        <Thumb x:Name="OperatorResizeThumb"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               Width="20"
                               Height="20"
                               Margin="0,0,1,1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Panel.ZIndex="10"
                               Cursor="SizeNWSE"
                               DragDelta="OperatorResizeThumb_DragDelta"
                               ToolTip="Изменить размер">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="#66FFD700" BorderBrush="#CCFFFFFF" BorderThickness="1" CornerRadius="2"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
                <Border x:Name="FanucFloatingHost"
                        Canvas.Left="24"
                        Canvas.Top="24"
                        MinWidth="640"
                        MinHeight="440"
                        Background="#DD1F1F1F"
                        BorderBrush="#FF6A6A6A"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*" MinHeight="0"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="FanucFloatingHeader"
                                Grid.Row="0"
                                Height="34"
                                Background="#FF2D2D30"
                                CornerRadius="6,6,0,0"
                                MouseLeftButtonDown="FanucFloatingHeader_MouseLeftButtonDown"
                                MouseMove="FanucFloatingHeader_MouseMove"
                                MouseLeftButtonUp="FanucFloatingHeader_MouseLeftButtonUp">
                            <DockPanel LastChildFill="False" Margin="8,0">
                                <TextBlock Text="FANUC 0i-MF Plus"
                                           DockPanel.Dock="Left"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                                <Button x:Name="FanucMinimizeButton"
                                        DockPanel.Dock="Right"
                                        Width="24"
                                        Height="22"
                                        Margin="4,0,0,0"
                                        Content="_"
                                        Click="FanucMinimizeButton_Click"
                                        ToolTip="Свернуть / развернуть"/>
                                <Button x:Name="FanucResetSizeButton"
                                        DockPanel.Dock="Right"
                                        Width="24"
                                        Margin="0,0,0,0"
                                        Content="&#x21BA;"
                                        FontSize="14"
                                        Padding="0"
                                        Click="FanucResetSizeButton_Click"
                                        ToolTip="Размер по умолчанию"/>
                            </DockPanel>
                        </Border>

                        <Border x:Name="FanucFloatingContent" Grid.Row="1" Background="#FF0F0F0F" ClipToBounds="True" HorizontalAlignment="Stretch">
                            <ScrollViewer x:Name="FanucContentScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0"
                                          Background="#FF0F0F0F">
                                <fanuc:FanucPanelControl x:Name="FanucPanel" Margin="6" HorizontalAlignment="Stretch" Loaded="FanucPanel_Loaded"/>
                            </ScrollViewer>
                        </Border>

                        <Thumb x:Name="FanucResizeThumb"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               Width="20"
                               Height="20"
                               Margin="0,0,1,1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Panel.ZIndex="10"
                               Cursor="SizeNWSE"
                               DragDelta="FanucResizeThumb_DragDelta"
                               ToolTip="Изменить размер">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="#66FFD700" BorderBrush="#CCFFFFFF" BorderThickness="1" CornerRadius="2"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
            </Canvas>

            <!-- FPS Counter (Top Right) -->
            <Border Grid.Column="0" 
                    VerticalAlignment="Top" 
                    HorizontalAlignment="Right" 
                    Margin="10" 
                    Padding="8,4"
                    Background="#80000000" 
                    CornerRadius="4"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FPS: " Foreground="White" FontSize="12"/>
                    <TextBlock x:Name="FpsText" Text="0" Foreground="Lime" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Overlay Panel (Bottom Left) -->
            <Border Grid.Column="0" 
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Left" 
                    Margin="20" 
                    Padding="15"
                    Background="#80000000" 
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ToolText" Text="Инструмент: -" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="CoordSystemText" Text="СК: G54" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="RefSystemText" Text="Отсчет: ABS" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="PositionText" Text="X: 0.000 Y: 0.000 Z: 0.000" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,5,0,2"/>
                    <TextBlock x:Name="FeedStatusText" Text="F: 0 мм/мин" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="SpindleStatusText" Text="S: 0 об/мин (M5)" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="CoolantText" Text="СОЖ: ВЫКЛ" Foreground="White" FontSize="14" Margin="0,2"/>
                    <TextBlock x:Name="ResolutionStatusText" Text="Точность: 1.0 мм" Foreground="White" FontSize="14" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- Central Progress Bar Panel -->
            <Border Grid.Column="0" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="20,15"
                    Background="#D0000000" 
                    CornerRadius="12"
                    x:Name="StockProgressPanel"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Расчет воксельной модели..." Foreground="SkyBlue" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="StockProgressBar" Height="8" Width="300" Minimum="0" Maximum="100" IsIndeterminate="True" Foreground="SkyBlue" Background="#40FFFFFF" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Hidden technical host: keeps bindings/events used by runtime logic. -->
            <Border Grid.Column="0" Visibility="Collapsed">
                <Grid>
                    <ListBox x:Name="GCodeList" SelectionChanged="GCodeList_SelectionChanged"/>
                    <ListBox x:Name="ToolsList" SelectionChanged="ToolsList_SelectionChanged"/>
                    <TextBox x:Name="StatsBox"/>
                    <Button x:Name="PlayButton" Click="PlayButton_Click"/>
                    <Button x:Name="StopButton" Click="StopButton_Click"/>
                    <Button x:Name="PauseButton" Click="PauseButton_Click"/>
                    <TextBlock x:Name="WorkOverrideText"/>
                    <Slider x:Name="WorkOverrideSlider" Minimum="0" Maximum="120" Value="100" ValueChanged="OverrideSlider_ValueChanged"/>
                    <TextBlock x:Name="RapidOverrideText"/>
                    <Slider x:Name="RapidOverrideSlider" Minimum="0" Maximum="120" Value="100" ValueChanged="OverrideSlider_ValueChanged"/>
                    <CheckBox x:Name="StockVisibleCheck" IsChecked="True" Checked="StockVisible_Changed" Unchecked="StockVisible_Changed"/>
                    <TextBox x:Name="StockMinX" Text="-50"/>
                    <TextBox x:Name="StockMinY" Text="-50"/>
                    <TextBox x:Name="StockMinZ" Text="-20"/>
                    <TextBox x:Name="StockMaxX" Text="50"/>
                    <TextBox x:Name="StockMaxY" Text="50"/>
                    <TextBox x:Name="StockMaxZ" Text="0"/>
                    <ComboBox x:Name="StockColorCombo" SelectionChanged="StockColor_SelectionChanged">
                        <ComboBoxItem Content="Серый" Tag="LightGray" IsSelected="True"/>
                        <ComboBoxItem Content="Зеленый" Tag="LightGreen"/>
                        <ComboBoxItem Content="Синий" Tag="LightBlue"/>
                        <ComboBoxItem Content="Дерево" Tag="BurlyWood"/>
                        <ComboBoxItem Content="Медь" Tag="Coral"/>
                    </ComboBox>
                    <Button x:Name="FineResButton" Tag="0.1" Click="ResButton_Click"/>
                    <Button x:Name="MediumResButton" Tag="0.3" Click="ResButton_Click"/>
                    <Button x:Name="CoarseResButton" Tag="0.6" Click="ResButton_Click"/>
                    <CheckBox x:Name="AutoStockCheck" IsChecked="True"/>
                    <StackPanel x:Name="LegacyControlsPanel"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
